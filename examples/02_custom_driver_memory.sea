-- 02_custom_driver_memory.sea — Criando e registrando um driver orientado a documentos
--
-- Demonstra como implementar o contrato de driver do RDD para um banco de
-- documentos/objetos (estilo MongoDB / S3 / Key-Value em memória), onde os
-- sub-documentos são armazenados nativamente sem achatar tabelas.
--
-- O driver implementa só o obrigatório (insert, find, update, delete, close).
-- O resto vem do RDD: rdd.match avalia os filtros do plano, e joins,
-- agregações, count e save funcionam sobre o find() do driver.
--
-- Execução:
--   ~/projects/sea_vm/bin/sea examples/02_custom_driver_memory.sea

local rdd = require("../rdd")

-- Define um valor em um caminho "endereco.cidade" dentro de um documento
local function set_path(doc, path, val)
    local parts = string.split(path, ".")
    local curr = doc
    for i = 0, len(parts) - 2 do
        local p = parts[i]
        if curr[p] == nil then curr[p] = {} end
        curr = curr[p]
    end
    curr[parts[-1]] = val
end

local function copy(doc)
    return json.decode(json.encode(doc))
end

local function compare(a, b)
    if a == b then return 0 end
    if a == nil then return -1 end
    if b == nil then return 1 end
    return a < b and -1 or 1
end

-- ---- Registro do driver "memory_doc" ----

rdd.register_driver("memory_doc", {
    open = function(_)
        local store = [=]
        local seq = [=]
        local conn = {}

        local function bucket(name)
            local b, ok = store[name]
            if not ok then
                b = []
                store[name] = b
                seq[name] = 0
            end
            return b
        end

        function conn.insert(_, schema, doc)
            local b = bucket(schema.name)
            local c = copy(doc)
            local pk = schema.primary_key
            if pk ~= nil and c[pk] == nil then
                seq[schema.name] += 1
                c[pk] = seq[schema.name]
            end
            b[] = c
            return copy(c)
        end

        function conn.find(_, schema, plan)
            local out = []
            for _, doc in bucket(schema.name) do
                -- rdd.match entende todos os operadores e grupos do plano
                if rdd.match(doc, plan.filters) then out[] = copy(doc) end
            end
            if len(plan.orders) > 0 then
                sort.sort(out, function(a, b)
                    for _, o in plan.orders do
                        local c = compare(rdd.get_path(a, o.field), rdd.get_path(b, o.field))
                        if c ~= 0 then
                            if o.dir == "desc" then return c > 0 end
                            return c < 0
                        end
                    end
                    return false
                end)
            end
            local start = plan.offset or 0
            local stop = len(out)
            if plan.limit ~= nil and start + plan.limit < stop then stop = start + plan.limit end
            if start >= stop then return [] end
            local sliced = list.slice(out, start, stop)
            if len(plan.fields) == 0 then return sliced end
            -- Projeção: um caminho aninhado traz o campo raiz inteiro
            local projected = []
            for _, d in sliced do
                local p = {}
                for _, f in plan.fields do
                    local root = string.split(f, ".")[0]
                    p[root] = d[root]
                end
                projected[] = p
            end
            return projected
        end

        function conn.update(_, schema, plan, changes)
            local updated = 0
            for _, doc in bucket(schema.name) do
                if rdd.match(doc, plan.filters) then
                    for k, v in changes do set_path(doc, k, v) end
                    updated += 1
                end
            end
            return updated
        end

        function conn.delete(_, schema, plan)
            local kept = []
            local deleted = 0
            for _, doc in bucket(schema.name) do
                if rdd.match(doc, plan.filters) then
                    deleted += 1
                else
                    kept[] = doc
                end
            end
            store[schema.name] = kept
            return deleted
        end

        function conn.close(_)
            return true
        end

        return conn
    end,
})

-- ---- Uso da aplicação (independente do driver) ----

local Clientes = rdd.schema("clientes", {
    id = {type = "int", primary_key = true, auto = true},
    nome = {type = "string", required = true},
    email = "string",
    ativo = {type = "bool", default_val = true},
    saldo = {type = "number", default_val = 0.0},
    endereco = {
        cidade = {type = "string", required = true},
        uf = {type = "string", default_val = "SP"},
    },
})

local Pedidos = rdd.schema("pedidos", {
    id = {type = "int", primary_key = true, auto = true},
    cliente_id = {type = "int", required = true},
    produto = {type = "string", required = true},
    valor = {type = "number", required = true},
})

local function main()
    local db = rdd.open("memory_doc")?
    defer db:close()

    local clientes = db:model(Clientes)
    local pedidos = db:model(Pedidos)

    local _ = clientes:insert_many([
        {nome = "Ana", email = "ana@example.com", saldo = 1200.0, endereco = {cidade = "São Paulo", uf = "SP"}},
        {nome = "Carlos", saldo = 450.0, endereco = {cidade = "Curitiba", uf = "PR"}},
        {nome = "Beatriz", email = "bia@example.com", saldo = 3100.0, endereco = {cidade = "Campinas", uf = "SP"}},
        {nome = "Diego", email = "diego@example.com", saldo = 80.0, ativo = false, endereco = {cidade = "Recife", uf = "PE"}},
    ])?
    _ = pedidos:insert_many([
        {cliente_id = 1, produto = "Teclado", valor = 450.0},
        {cliente_id = 3, produto = "Monitor 4K", valor = 2200.0},
        {cliente_id = 3, produto = "Mouse", valor = 300.0},
        {cliente_id = 2, produto = "Cabo HDMI", valor = 40.0},
    ])?

    print("=== Clientes de SP ordenados por maior saldo ===")
    local paulistas = clientes:where("endereco.uf", "SP"):order_by("-saldo"):all()?
    for _, c in paulistas do
        printf("  #%d %s (%s/%s) - R$ %.2f\n", c.id, c.nome, c.endereco.cidade, c.endereco.uf, c.saldo)
    end

    print("\n=== Condição como expressão: (SP ou PR) e ativo, com e-mail ===")
    local filtrados = clientes:where("(endereco.uf = ? or endereco.uf = ?) and ativo = ?", "SP", "PR", true)
        :where("email", "!=", nil)
        :order_by("nome")
        :all()?
    for _, c in filtrados do printf("  %s <%s>\n", c.nome, c.email) end

    print("\n=== Sem e-mail (where com nil vira is_null) ===")
    for _, c in clientes:where("email", nil):all()? do printf("  %s\n", c.nome) end

    -- Atualizando sub-documento via dot-notation
    _ = clientes:where("nome", "Carlos"):update({
        saldo = 900.0,
        ["endereco.cidade"] = "Londrina",
    })?
    local carlos = clientes:where("nome", "Carlos"):first()?
    printf("\nApós update -> %s agora mora em %s/%s com saldo R$ %.2f\n",
        carlos.nome, carlos.endereco.cidade, carlos.endereco.uf, carlos.saldo)

    -- save(): com id existente atualiza; sem id insere
    _ = clientes:save({id = 4, nome = "Diego", saldo = 150.0, ativo = true, endereco = {cidade = "Olinda", uf = "PE"}})?
    local diego = clientes:find(4)?
    printf("save() -> %s agora em %s, ativo = %s\n", diego.nome, diego.endereco.cidade, tostring(diego.ativo))

    -- Joins: o driver não sabe fazer join, então o RDD junta em memória
    print("\n=== Pedidos com o nome do cliente (join) ===")
    local itens = pedidos:join(Clientes, "c", "c.id = cliente_id")
        :where("valor", ">=", 100)
        :order_by("-valor")
        :all()?
    for _, p in itens do printf("  %-12s R$ %8.2f  %s (%s)\n", p.produto, p.valor, p.c.nome, p.c.endereco.uf) end

    print("\n=== Total comprado por cliente (left join + agregação) ===")
    local vendas = clientes:left_join(Pedidos, "p", "p.cliente_id = id")
        :group_by("nome")
        :aggregate({pedidos = "count(p.id)", total = "sum(p.valor)"})
        :order_by("-total")
        :all()?
    for _, r in vendas do
        printf("  %-8s %d pedido(s)  R$ %8.2f\n", r.nome, r.pedidos, r.total or 0.0)
    end

    -- Agregações sem join: também calculadas pelo RDD sobre o find()
    print("\n=== Saldo por UF ===")
    local por_uf = clientes:group_by("endereco.uf")
        :aggregate({n = "count(*)", total = "sum(saldo)"})
        :order_by("-total")
        :all()?
    for _, r in por_uf do
        printf("  %s: %d cliente(s), R$ %.2f\n", r["endereco.uf"], r.n, r.total)
    end
    printf("Saldo total: R$ %.2f | maior saldo: R$ %.2f\n", clientes:sum("saldo")?, clientes:max("saldo")?)

    local pagina = clientes:order_by("nome"):paginate(1, 2)?
    printf("Página %d de %d (%d clientes): %s, %s\n", pagina.page, pagina.pages, pagina.total,
        pagina.items[0].nome, pagina.items[1].nome)
end

local err = main()
if is_error(err) then panic(err.message) end
