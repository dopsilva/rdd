-- 01_schemas_and_queries.sea — Definindo schemas aninhados e inspecionando a AST de queries
--
-- Execução:
--   ~/projects/sea_vm/bin/sea examples/01_schemas_and_queries.sea

local rdd = require("../rdd")

-- 1. Sub-schema de endereço (pode ser reutilizado em vários schemas)
local Endereco = rdd.schema("enderecos", {
    rua = {type = "string", required = true},
    numero = "int",
    cidade = {type = "string", required = true},
    uf = {type = "string", default_val = "SP", min = 2, max = 2},
})

-- 2. Schema principal com sub-documento (Endereco) e lista de sub-documentos (contatos)
local Clientes = rdd.schema("clientes", {
    id = {type = "uuid", primary_key = true, auto = true},
    nome = {type = "string", required = true, min = 2},
    email = {type = "string", unique = true},
    ativo = {type = "bool", default_val = true},
    saldo = {type = "number", default_val = 0.0},
    criado_em = {type = "time", auto = true},
    endereco = Endereco,
    tags = {type = "array", items = "string"},
    contatos = {
        type = "array",
        items = {
            tipo = {type = "string", required = true},
            valor = {type = "string", required = true},
        },
    },
})

print("=== 1. Validando um documento (com defaults e campos auto-gerados) ===")
local doc = Clientes:validate({
    nome = "Maria Silva",
    email = "maria@example.com",
    endereco = {
        rua = "Av. Paulista",
        numero = 1000,
        cidade = "São Paulo",
    },
    tags = ["vip", "varejo"],
    contatos = [
        {tipo = "whatsapp", valor = "+55 11 99999-0000"},
    ],
})
if is_error(doc) then
    panic(doc.message)
end
dump(doc)

print("\n=== 2. Exemplo de erro de validação em campo aninhado ===")
local invalido = Clientes:validate({
    nome = "João",
    endereco = {rua = "Rua Sem Cidade"},
})
if is_error(invalido) then
    print("Erro capturado:", invalido.message)
end

-- Mostra um plano sem os schemas (que são grandes) para ficar legível
local function show(query)
    local plan = query:to_plan()
    if is_error(plan) then panic(plan.message) end
    plan.schema = `<Schema:${plan.schema.name}>`
    for _, j in plan.joins or [] do j.schema = `<Schema:${j.schema.name}>` end
    dump(plan)
end

print("\n=== 3. Gerando o Query Plan (AST) abstrato para drivers ===")
show(rdd.query(Clientes)
    :fields("id", "nome", "saldo", "endereco.cidade")
    :where("ativo", true)
    :where("saldo", ">=", 500)
    :where("endereco.uf", "SP")
    :or_where(function(sub)
        sub:where("endereco.uf", "RJ"):where("tags", "in", ["vip", "ouro"])
    end)
    :order_by("saldo desc, nome")
    :limit(10)
    :offset(0))

-- A mesma ideia escrita como expressão. and liga mais forte que or, como no
-- SQL, e o plano deixa os grupos explícitos.
print("\n=== 4. Condição como expressão (valores sempre como ?) ===")
show(rdd.query(Clientes)
    :where("ativo = ? and (endereco.uf = 'SP' or endereco.uf = ?) and saldo between ? and ?", true, "RJ", 500, 5000)
    :where("email", nil)) -- nil vira is_null

print("\n=== 5. Erros (campo desconhecido, ? sem valor, parêntese aberto) voltam no plano ===")
print(rdd.query(Clientes):where("(nome = ? or apelido = ?)", "Ana", "Aninha"):to_plan())
print(rdd.query(Clientes):where("nome = ? and saldo > ?", "Ana"):to_plan())
print(rdd.query(Clientes):where("(nome = ?", "Ana"):to_plan())

local Pedidos = rdd.schema("pedidos", {
    id = {type = "int", primary_key = true, auto = true},
    cliente_id = {type = "uuid", required = true},
    produto = {type = "string", required = true},
    valor = {type = "number", required = true},
})

print("\n=== 6. Join e agregação: total por cliente de SP ===")
show(rdd.query(Clientes)
    :left_join(Pedidos, "p", "p.cliente_id = id")
    :where("endereco.uf", "SP")
    :group_by("nome")
    :aggregate({pedidos = "count(p.id)", total = "sum(p.valor)"})
    :order_by("-total")
    :limit(5))
