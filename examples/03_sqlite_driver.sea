-- 03_sqlite_driver.sea — O mesmo modelo e queries rodando sobre SQLite
--
-- Demonstra como a aplicação mantém exatamente a mesma definição de Schema
-- (incluindo documentos aninhados e arrays) e a mesma API de queries fluentes,
-- trocando apenas o driver registrado para SQLite.
--
-- Execução:
--   ~/projects/sea_vm/bin/sea examples/03_sqlite_driver.sea

local sqlite = require("../../sea_vm/libs/sqlite/sqlite")
local rdd = require("../rdd")

-- ---- Driver SQLite para o RDD ----
--
-- O rdd.sql compila os planos de query em SQL parametrizado (WHERE com
-- grupos, in, between, is null, contains..., ORDER BY, LIMIT/OFFSET, INSERT,
-- UPDATE em campos aninhados, CREATE TABLE). O driver só liga o banco a ele.
-- Para PostgreSQL ou SQL Server, troque o dialeto (rdd.sql.dialects.postgres,
-- rdd.sql.dialects.sqlserver) e o objeto de conexão.

rdd.register_driver("sqlite", {
    open = function(opts)
        local db = sqlite.open(opts.path or ":memory:")?
        return rdd.sql.connection(db, rdd.sql.dialects.sqlite)
    end,
})

-- ---- Código da aplicação (idêntico ao exemplo 02!) ----

local Clientes = rdd.schema("clientes", {
    id = {type = "int", primary_key = true, auto = true},
    nome = {type = "string", required = true},
    ativo = {type = "bool", default_val = true},
    saldo = {type = "number", default_val = 0.0},
    endereco = {
        cidade = {type = "string", required = true},
        uf = {type = "string", default_val = "SP"},
    },
    pedidos = {
        type = "array",
        items = {
            produto = "string",
            valor = "number",
        },
    },
})

local function main()
    local db = rdd.open("sqlite", {path = ":memory:"})?
    defer db:close()

    local _ = db:migrate(Clientes)?
    local clientes = db:model(Clientes)

    local _ = clientes:insert_many([
        {
            nome = "Ana",
            saldo = 1200.0,
            endereco = {cidade = "São Paulo", uf = "SP"},
            pedidos = [{produto = "Teclado Mecânico", valor = 450.0}],
        },
        {
            nome = "Carlos",
            saldo = 450.0,
            endereco = {cidade = "Curitiba", uf = "PR"},
            pedidos = [],
        },
        {
            nome = "Beatriz",
            saldo = 3100.0,
            endereco = {cidade = "Campinas", uf = "SP"},
            pedidos = [
                {produto = "Monitor 4K", valor = 2200.0},
                {produto = "Mouse", valor = 300.0},
            ],
        },
    ])?

    print("=== [SQLite] Clientes de SP ordenados por maior saldo ===")
    local paulistas = clientes:where("endereco.uf", "SP"):order_by("-saldo"):all()?
    for _, c in paulistas do
        printf("  #%d %s (%s/%s) - Saldo: R$ %.2f - Pedidos: %d\n",
            c.id, c.nome, c.endereco.cidade, c.endereco.uf, c.saldo, len(c.pedidos))
    end

    -- Transferência dentro de uma transação
    local _ = db:transaction(function(tx)
        local tx_c = tx:model(Clientes)
        local _ = tx_c:where("nome", "Beatriz"):update({saldo = 2600.0})?
        local _ = tx_c:where("nome", "Carlos"):update({saldo = 950.0})?
        return true
    end)?

    local carlos = clientes:where("nome", "Carlos"):first()?
    local beatriz = clientes:where("nome", "Beatriz"):first()?
    printf("\nApós transação -> Beatriz: R$ %.2f | Carlos: R$ %.2f\n", beatriz.saldo, carlos.saldo)
end

local err = main()
if is_error(err) then panic(err.message) end
