local t = require("sea/test")
local sqlite = require("../sea_vm/libs/sqlite/sqlite")
local rdd = require("./rdd")

-- ---- SQLite driver registered for testing RDD contracts (rdd/sql does the SQL) ----

local function make_sqlite_driver()
    return {
        open = function(opts)
            local db = sqlite.open(opts.path or ":memory:")?
            return rdd.sql.connection(db, rdd.sql.dialects.sqlite)
        end,
    }
end

-- ---- Test Suites ----

local Endereco = rdd.schema("enderecos", {
    rua = {type = "string", required = true},
    numero = "int",
    cidade = {type = "string", required = true},
    uf = {type = "string", default_val = "SP", min = 2, max = 2},
})

local Clientes = rdd.schema("clientes", {
    id = {type = "int", primary_key = true, auto = true},
    nome = {type = "string", required = true, min = 2},
    email = {type = "string", unique = true},
    ativo = {type = "bool", default_val = true},
    saldo = {type = "number", default_val = 0.0},
    endereco = Endereco,
    tags = {type = "array", items = "string"},
    contatos = {
        type = "array",
        items = {
            tipo = {type = "string", required = true},
            valor = {type = "string", required = true},
        },
    },
})

local Pedidos = rdd.schema("pedidos", {
    id = {type = "int", primary_key = true, auto = true},
    cliente_id = {type = "int", required = true},
    produto = {type = "string", required = true},
    valor = "number",
    pago = {type = "bool", default_val = false},
})

t.describe("rdd driver registry", function()
    t.it("registers, lists, and unregisters drivers", function()
        t.is_error(rdd.register_driver("", {}), "non-empty string")
        t.is_error(rdd.register_driver("bad", {}), "must implement open")

        local ok = rdd.register_driver("dummy", {
            open = function(_) return error("not implemented") end,
        })
        t.no_error(ok)
        t.ok(rdd.has_driver("dummy"))
        t.contains(rdd.drivers(), "dummy")

        t.ok(rdd.unregister_driver("dummy"))
        t.no(rdd.has_driver("dummy"))
    end)

    t.it("validates connection contract on open", function()
        rdd.register_driver("incomplete", {
            open = function(_)
                return {insert = function() end}
            end,
        })
        defer rdd.unregister_driver("incomplete")

        local db = rdd.open("incomplete")
        t.is_error(db, "missing required method 'find'")
    end)
end)

t.describe("rdd schema and nested document validation", function()
    t.it("validates flat and chained document fields with defaults", function()
        local doc = t.no_error(Clientes:validate({
            nome = "Maria Silva",
            email = "maria@example.com",
            endereco = {
                rua = "Av. Paulista",
                numero = 1000,
                cidade = "São Paulo",
            },
            tags = ["vip", "varejo"],
            contatos = [
                {tipo = "celular", valor = "11999999999"},
                {tipo = "email", valor = "maria@example.com"},
            ],
        }))

        t.eq(doc.nome, "Maria Silva")
        t.eq(doc.ativo, true)
        t.eq(doc.saldo, 0.0)
        t.eq(doc.endereco.uf, "SP")
        t.eq(doc.endereco.cidade, "São Paulo")
        t.eq(len(doc.tags), 2)
        t.eq(doc.contatos[0].tipo, "celular")
    end)

    t.it("reports clear dot-path errors on nested fields and arrays", function()
        local err1 = Clientes:validate({
            nome = "Joao",
            endereco = {rua = "Rua A"},
        })
        t.is_error(err1, "clientes.endereco.cidade' is required")

        local err2 = Clientes:validate({
            nome = "Joao",
            contatos = [{tipo = "tel"}],
        })
        t.is_error(err2, "clientes.contatos[0].valor' is required")

        local err3 = Clientes:validate({
            nome = "Joao",
            campo_fantasma = 123,
        })
        t.is_error(err3, "unknown field 'clientes.campo_fantasma'")
    end)

    t.it("resolves dot-paths and validates partial updates", function()
        local uf_field = Clientes:field_at("endereco.uf")
        t.not_nil(uf_field)
        t.eq(uf_field.type, "string")

        local ch = t.no_error(Clientes:validate_changes({
            saldo = 250.5,
            ["endereco.cidade"] = "Campinas",
        }))
        t.eq(ch.saldo, 250.5)
        t.eq(ch["endereco.cidade"], "Campinas")

        t.is_error(Clientes:validate_changes({["endereco.uf"] = "S"}), "length must be >= 2")
        t.is_error(Clientes:validate_changes({inexistente = 1}), "unknown field")
    end)
end)

t.describe("rdd query builder and abstract query plan (AST)", function()
    t.it("builds a driver-agnostic AST for complex queries", function()
        local q = rdd.query(Clientes):fields("id", "nome", "endereco.cidade"):where("ativo", true):where("saldo", ">=", 100):where("endereco.uf", "SP"):or_where(function(sub)
            sub:where("endereco.uf", "RJ"):where("nome", "in", ["Ana", "Bia"])
        end):order_by("-saldo", "nome"):limit(20):offset(40)

        local plan = t.no_error(q:to_plan())
        t.eq(plan.collection, "clientes")
        t.eq(plan.fields, ["id", "nome", "endereco.cidade"])
        t.eq(len(plan.filters), 4)
        t.eq(plan.filters[0], {kind = "cond", logic = "and", field = "ativo", op = "=", value = true})
        t.eq(plan.filters[1], {kind = "cond", logic = "and", field = "saldo", op = ">=", value = 100})
        t.eq(plan.filters[2], {kind = "cond", logic = "and", field = "endereco.uf", op = "=", value = "SP"})
        t.eq(plan.filters[3].kind, "group")
        t.eq(plan.filters[3].logic, "or")
        t.eq(len(plan.filters[3].filters), 2)
        t.eq(plan.orders, [{field = "saldo", dir = "desc"}, {field = "nome", dir = "asc"}])
        t.eq(plan.limit, 20)
        t.eq(plan.offset, 40)
    end)

    t.it("parses condition expressions with ? placeholders into the same plan", function()
        local q = rdd.query(Clientes):where("(nome = ? or email = ?) and endereco.uf = ?", "A", "B", "C")
        local plan = t.no_error(q:to_plan())
        t.eq(len(plan.filters), 2)
        t.eq(plan.filters[0].kind, "group")
        t.eq(plan.filters[0].filters, [
            {kind = "cond", logic = "and", field = "nome", op = "=", value = "A"},
            {kind = "cond", logic = "or", field = "email", op = "=", value = "B"},
        ])
        t.eq(plan.filters[1], {kind = "cond", logic = "and", field = "endereco.uf", op = "=", value = "C"})
        -- the same as the fluent form with a grouped sub-query
        local fluent = rdd.query(Clientes):where(function(g)
            g:where("nome", "A"):or_where("email", "B")
        end):where("endereco.uf", "C")
        t.eq(t.no_error(fluent:to_plan()).filters, plan.filters)

        -- literals, in / not in / between / is null, keywords in any case
        local p2 = t.no_error(rdd.query(Clientes):where(
            "nome IN ('Ana', 'O''Brien') AND saldo BETWEEN 10 AND 20.5 AND email IS NOT NULL AND id not in ?", [7, 8]
        ):to_plan())
        t.eq(p2.filters[0].value, ["Ana", "O'Brien"])
        t.eq(p2.filters[1].value, [10, 20.5])
        t.eq(p2.filters[2].op, "is_not_null")
        t.eq(p2.filters[3], {kind = "cond", logic = "and", field = "id", op = "not_in", value = [7, 8]})

        t.is_error(rdd.query(Clientes):where("nme = ?", 1):to_plan(), "unknown field 'clientes.nme'")
        t.is_error(rdd.query(Clientes):where("nome = ?"):to_plan(), "more '?' than values")
        t.is_error(rdd.query(Clientes):where("nome = ?", 1, 2):to_plan(), "more values than '?'")
        t.is_error(rdd.query(Clientes):where("(nome = ?", 1):to_plan(), "expected ')'")
    end)

    t.it("reads a mixed and/or chain with SQL precedence, made explicit", function()
        -- a or b and c is a or (b and c): the and run becomes a group
        local plan = t.no_error(rdd.query(Clientes):where("nome", "a"):or_where("email", "b"):where("ativo", true):to_plan())
        t.eq(len(plan.filters), 2)
        t.eq(plan.filters[0].field, "nome")
        t.eq(plan.filters[1].kind, "group")
        t.eq(plan.filters[1].logic, "or")
        t.eq(len(plan.filters[1].filters), 2)
    end)

    t.it("takes every operator through where(field, op, value...)", function()
        local function filters(q) return t.no_error(q:to_plan()).filters end
        local function cond(field, op, value) return {kind = "cond", logic = "and", field = field, op = op, value = value} end
        local q = rdd.query(Clientes)
        t.eq(filters(q:clone():where("endereco.uf", "in", ["SP", "RJ"])), [cond("endereco.uf", "in", ["SP", "RJ"])])
        t.eq(filters(q:clone():where("endereco.uf", "NOT  In", ["SP"])), [cond("endereco.uf", "not_in", ["SP"])])
        t.eq(filters(q:clone():where("saldo", "between", 10, 20)), [cond("saldo", "between", [10, 20])])
        t.eq(filters(q:clone():where("nome", "starts with", "A")), [cond("nome", "starts_with", "A")])
        t.eq(filters(q:clone():where("email", "is not null", nil)), [cond("email", "is_not_null", nil)])
        t.eq(filters(q:clone():where("email", "<>", nil)), [cond("email", "is_not_null", nil)])
        -- a table: equalities, an array value is in
        t.eq(filters(q:clone():where({ativo = true, nome = ["Ana", "Bia"]})), [cond("ativo", "=", true), cond("nome", "in", ["Ana", "Bia"])])
        -- the same plan as the expression
        t.eq(filters(q:clone():where("endereco.uf", "in", ["SP"]):where("saldo", "between", 1, 2)),
            filters(q:clone():where("endereco.uf in ? and saldo between ? and ?", ["SP"], 1, 2)))
        local raw = filters(q:clone():where(rdd.raw("lower(nome) = ?", "ana")))
        t.eq(raw, [{kind = "raw", logic = "and", sql = "lower(nome) = ?", values = ["ana"]}])
        t.is_error(q:clone():where("saldo", ">", 1, 2):to_plan(), "only between takes two")
        t.is_error(q:clone():where("saldo", "entre", 1):to_plan(), "invalid query operator 'entre'")
        t.is_error(q:clone():where(rdd.raw("")):to_plan(), "raw() expects")
    end)

    t.it("orders by several fields in one order_by", function()
        local function orders(q) return t.no_error(q:to_plan()).orders end
        local want = [{field = "saldo", dir = "desc"}, {field = "endereco.uf", dir = "asc"}, {field = "nome", dir = "asc"}]
        local q = rdd.query(Clientes)
        t.eq(orders(q:clone():order_by("-saldo", "endereco.uf", "+nome")), want)
        t.eq(orders(q:clone():order_by("saldo DESC, endereco.uf asc, nome")), want)
        t.eq(orders(q:clone():order_by(["-saldo", "endereco.uf", "nome"])), want)
        t.eq(orders(q:clone():order_by("-saldo"):order_by("endereco.uf"):order_by("nome")), want)
        t.eq(orders(q:clone():order_by("nome", "desc")), [{field = "nome", dir = "desc"}])
        t.is_error(q:clone():order_by("nome desc asc"):to_plan(), "expected field, -field")
        t.is_error(q:clone():order_by():to_plan(), "at least one field")
        t.is_error(q:clone():order_by("-peso", "nome"):to_plan(), "unknown field 'clientes.peso'")
    end)

    t.it("catches unknown fields in fluent query chains", function()
        local q = rdd.query(Clientes):where("endereco.pais", "BR"):order_by("nome")
        t.is_error(q:to_plan(), "unknown field 'clientes.endereco.pais'")
    end)
end)

t.describe("rdd/sql compiler and dialects", function()
    local plan = t.no_error(rdd.query(Clientes)
        :where("(nome = ? or endereco.uf = ?) and saldo between ? and ?", "Ana", "SP", 10, 20)
        :where("nome", "ilike", "a%"):where("id", "in", [])
        :order_by("-saldo"):limit(5):offset(10)
        :to_plan())
    local sql = rdd.sql

    t.it("numbers placeholders and pages per dialect", function()
        local st = t.no_error(sql.find(Clientes, plan, sql.dialects.postgres))
        t.eq(st.sql, string.join([
            "SELECT * FROM \"clientes\" WHERE (\"nome\" = $1 OR \"endereco\" #>> '{uf}' = $2)",
            "AND \"saldo\" BETWEEN $3 AND $4 AND \"nome\" ILIKE $5 AND 1 = 0",
            "ORDER BY \"saldo\" DESC LIMIT 5 OFFSET 10",
        ], " "))
        t.eq(st.params, ["Ana", "SP", 10, 20, "a%"])
        st = t.no_error(sql.find(Clientes, plan, sql.dialects.sqlserver))
        t.eq(st.sql, string.join([
            "SELECT * FROM [clientes] WHERE ([nome] = @p1 OR JSON_VALUE([endereco], '$.uf') = @p2)",
            "AND [saldo] BETWEEN @p3 AND @p4 AND LOWER([nome]) LIKE LOWER(@p5) AND 1 = 0",
            "ORDER BY [saldo] DESC OFFSET 10 ROWS FETCH NEXT 5 ROWS ONLY",
        ], " "))
        local E = rdd.schema("e", {id = {type = "int", primary_key = true}, nome = "string"})
        t.eq(t.no_error(sql.upsert(E, {id = 1, nome = "x"}, sql.dialects.postgres)).sql,
            "INSERT INTO \"e\" (\"id\", \"nome\") VALUES ($1, $2) ON CONFLICT (\"id\") DO UPDATE SET \"nome\" = excluded.\"nome\"")
        t.eq(t.no_error(sql.upsert(E, {id = 1, nome = "x"}, sql.dialects.sqlserver)).sql, string.join([
            "MERGE INTO [e] AS dst USING (SELECT @p1 AS [id], @p2 AS [nome]) AS src ON dst.[id] = src.[id]",
            "WHEN MATCHED THEN UPDATE SET [nome] = src.[nome]",
            "WHEN NOT MATCHED THEN INSERT ([id], [nome]) VALUES (src.[id], src.[nome]);",
        ], " "))
        t.is_error(sql.upsert(E, {nome = "x"}, sql.dialects.sqlite), "needs the primary key value")
    end)

    t.it("escapes LIKE patterns, quotes identifiers and continues parameters", function()
        local p = t.no_error(rdd.query(Clientes):where("nome", "contains", "50%_"):to_plan())
        local st = t.no_error(sql.find(Clientes, p, sql.dialects.sqlite))
        t.eq(st.sql, "SELECT * FROM \"clientes\" WHERE \"nome\" LIKE ? ESCAPE '\\'")
        t.eq(st.params, ["%50\\%\\_%"])
        local params = ["x"]
        t.eq(t.no_error(sql.where(Clientes, p.filters, sql.dialects.postgres, params)), "\"nome\" LIKE $2 ESCAPE '\\'")
        t.eq(len(params), 2)
        local d = sql.dialect({quote = function(n) return "`" .. n .. "`" end})
        t.eq(sql.create_table(Endereco, d),
            "CREATE TABLE IF NOT EXISTS `enderecos` (`cidade` TEXT, `numero` INTEGER, `rua` TEXT, `uf` TEXT)")
    end)
end)

t.describe("rdd end-to-end with registered SQLite driver", function()
    local db = nil
    local model = nil

    t.before_all(function()
        rdd.register_driver("sqlite_test", make_sqlite_driver())
    end)

    t.after_all(function()
        rdd.unregister_driver("sqlite_test")
    end)

    t.before_each(function()
        db = t.no_error(rdd.open("sqlite_test", {path = ":memory:"}))
        t.no_error(db:migrate(Clientes))
        model = db:model(Clientes)
    end)

    t.after_each(function()
        if db ~= nil then db:close() end
    end)

    t.it("inserts, queries nested fields, updates, and deletes", function()
        local c1 = t.no_error(model:insert({
            nome = "Ana Costa",
            email = "ana@example.com",
            saldo = 1500.0,
            endereco = {rua = "Rua das Flores", numero = 10, cidade = "São Paulo", uf = "SP"},
            tags = ["ouro"],
            contatos = [{tipo = "whatsapp", valor = "11988887777"}],
        }))
        t.eq(c1.id, 1)

        local _ = t.no_error(model:insert_many([
            {
                nome = "Bruno Lima",
                email = "bruno@example.com",
                saldo = 300.0,
                endereco = {rua = "Av. Atlântica", numero = 500, cidade = "Rio de Janeiro", uf = "RJ"},
                tags = ["prata"],
            },
            {
                nome = "Carla Souza",
                email = "carla@example.com",
                ativo = false,
                saldo = 2500.0,
                endereco = {rua = "Rua XV", numero = 99, cidade = "Campinas", uf = "SP"},
                tags = ["ouro", "vip"],
            },
        ]))

        t.eq(t.no_error(model:count()), 3)

        -- Find by primary key and verify nested structures are preserved
        local found = t.no_error(model:find(1))
        t.not_nil(found)
        t.eq(found.nome, "Ana Costa")
        t.eq(found.endereco.cidade, "São Paulo")
        t.eq(found.tags, ["ouro"])
        t.eq(found.contatos[0].valor, "11988887777")

        -- Query by nested document field ("endereco.uf") + ordering
        local paulistas = t.no_error(
            model:where("endereco.uf", "SP"):order_by("-saldo"):all()
        )
        t.eq(len(paulistas), 2)
        t.eq(paulistas[0].nome, "Carla Souza")
        t.eq(paulistas[1].nome, "Ana Costa")

        -- Partial update including nested dot-path
        local updated = t.no_error(
            model:where("id", 2):update({
                saldo = 450.0,
                ["endereco.cidade"] = "Niterói",
            })
        )
        t.eq(updated, 1)

        local bruno = t.no_error(model:find(2))
        t.eq(bruno.saldo, 450.0)
        t.eq(bruno.endereco.cidade, "Niterói")
        t.eq(bruno.endereco.uf, "RJ")

        -- An expression, and a mixed and/or chain read with SQL precedence:
        -- uf = RJ or (saldo > 2000 and inactive)
        local rows = t.no_error(model:where("(endereco.uf = ? or saldo > ?) and ativo = ?", "RJ", 2000, true):all())
        t.eq(len(rows), 1)
        t.eq(rows[0].nome, "Bruno Lima")
        rows = t.no_error(model:where("endereco.uf", "RJ"):or_where("saldo", ">", 2000):where("ativo", false)
            :order_by("nome"):all())
        t.eq(len(rows), 2)
        t.eq(rows[0].nome, "Bruno Lima")
        t.eq(rows[1].nome, "Carla Souza")

        -- Delete inactive records
        local deleted = t.no_error(model:where("ativo", false):delete())
        t.eq(deleted, 1)
        t.eq(t.no_error(model:count()), 2)
    end)

    t.it("runs every operator through rdd/sql", function()
        local _ = t.no_error(model:insert_many([
            {nome = "Ana", email = "ana@x.com", saldo = 10.0, endereco = {rua = "R", cidade = "Santos", uf = "SP"}},
            {nome = "Bia_1", email = "bia@x.com", saldo = 20.0, endereco = {rua = "R", cidade = "Rio", uf = "RJ"}},
            {nome = "Caio 50%", saldo = 30.0, endereco = {rua = "R", cidade = "Recife", uf = "PE"}},
            {nome = "Duda", email = "duda@x.com", saldo = 40.0, endereco = {rua = "R", cidade = "Natal", uf = "RN"}},
        ]))
        local function names(q)
            local out = []
            for _, r in t.no_error(q:order_by("nome"):all()) do out[] = r.nome end
            return string.join(out, ",")
        end
        t.eq(names(model:where("endereco.uf", "in", ["SP", "PE"])), "Ana,Caio 50%")
        t.eq(names(model:where("endereco.uf", "not in", ["SP", "PE"])), "Bia_1,Duda")
        t.eq(names(model:where("nome", "in", [])), "")
        t.eq(names(model:where("saldo", "between", 15, 35)), "Bia_1,Caio 50%")
        t.eq(names(model:where("email", nil)), "Caio 50%")
        t.eq(names(model:where("email", nil)), "Caio 50%")
        t.eq(names(model:where("email", "!=", nil):where("saldo", "<", 30)), "Ana,Bia_1")
        t.eq(names(model:where("email = ? or nome = ?", nil, "Ana")), "Ana,Caio 50%")
        t.eq(names(model:where("email is not null and saldo >= ?", 20)), "Bia_1,Duda")
        t.eq(names(model:where("nome", "contains", "50%")), "Caio 50%")
        t.eq(names(model:where("nome", "contains", "_")), "Bia_1")
        t.eq(names(model:where("nome", "starts_with", "D")), "Duda")
        t.eq(names(model:where("nome", "ends_with", "a")), "Ana,Duda")
        t.eq(names(model:where("nome", "ilike", "a%")), "Ana")
        t.eq(names(model:where("nome", "!=", "Ana"):limit(2):offset(1)), "Caio 50%,Duda")
        t.eq(t.no_error(model:where("saldo", ">", 10):limit(2):count()), 2)
        t.eq(t.no_error(model:query():offset(3):count()), 1)
        local proj = t.no_error(model:where("nome", "Ana"):fields("nome", "endereco.uf"):first())
        t.eq(proj.endereco.uf, "SP")
        t.is_nil(proj.saldo)
    end)

    t.it("aggregates and paginates, in SQL and in the in-memory fallback", function()
        local _ = t.no_error(model:insert_many([
            {nome = "Ana", email = "a@x.com", saldo = 10.0, endereco = {rua = "R", cidade = "Santos", uf = "SP"}},
            {nome = "Bia", email = "b@x.com", saldo = 20.0, ativo = false, endereco = {rua = "R", cidade = "Rio", uf = "RJ"}},
            {nome = "Caio", saldo = 30.0, endereco = {rua = "R", cidade = "Campinas", uf = "SP"}},
            {nome = "Duda", email = "d@x.com", saldo = 40.0, endereco = {rua = "R", cidade = "Recife", uf = "PE"}},
            {nome = "Eva", email = "e@x.com", saldo = 50.0, endereco = {rua = "R", cidade = "Osasco", uf = "SP"}},
        ]))
        local function check()
            local rows = t.no_error(model:group_by("endereco.uf")
                :aggregate({n = "count(*)", total = "sum(saldo)", emails = "count(email)", maior = "max(saldo)"})
                :order_by("-total"):all())
            t.eq(len(rows), 3)
            t.eq(rows[0]["endereco.uf"], "SP")
            t.eq(rows[0].n, 3)
            t.eq(rows[0].total, 90.0)
            t.eq(rows[0].emails, 2)
            t.eq(rows[0].maior, 50.0)
            t.eq(rows[2]["endereco.uf"], "RJ")

            rows = t.no_error(model:where("saldo", ">", 15):group_by("ativo")
                :aggregate({media = "avg(saldo)"}):order_by("ativo"):all())
            t.eq(len(rows), 2)
            t.eq(rows[0].ativo, false)
            t.eq(rows[0].media, 20.0)
            t.eq(rows[1].media, 40.0)

            rows = t.no_error(model:group_by("endereco.uf"):aggregate({n = "count(*)"})
                :order_by("endereco.uf"):limit(1):offset(1):all())
            t.eq(len(rows), 1)
            t.eq(rows[0]["endereco.uf"], "RJ")
            t.eq(t.no_error(model:group_by("endereco.uf"):aggregate({n = "count(*)"}):count()), 3)

            t.eq(t.no_error(model:sum("saldo")), 150.0)
            t.eq(t.no_error(model:where("endereco.uf", "SP"):avg("saldo")), 30.0)
            t.eq(t.no_error(model:min("nome")), "Ana")
            t.eq(t.no_error(model:max("saldo")), 50.0)
            t.is_nil(t.no_error(model:where("saldo", ">", 100):sum("saldo")))

            local pg = t.no_error(model:order_by("nome"):paginate(2, 2))
            t.eq(pg.total, 5)
            t.eq(pg.pages, 3)
            t.eq(len(pg.items), 2)
            t.eq(pg.items[0].nome, "Caio")
            t.eq(len(t.no_error(model:order_by("nome"):paginate(3, 2)).items), 1)
        end
        t.eq(type(model.conn.aggregate), "function")
        check()
        model.conn.aggregate = nil
        check()

        t.is_error(model:aggregate({x = "median(saldo)"}):all(), "expected count(*)")
        t.is_error(model:aggregate({x = "sum(*)"}):all(), "only count takes *")
        t.is_error(model:aggregate({x = "sum(peso)"}):all(), "unknown field")
        t.is_error(model:group_by("nome"):all(), "needs aggregate()")
        t.is_error(model:paginate(0, 10), "paginate")
    end)

    t.it("joins, in SQL and in the in-memory fallback", function()
        t.no_error(db:migrate(Pedidos))
        local pedidos = db:model(Pedidos)
        local _ = t.no_error(model:insert_many([
            {nome = "Ana", saldo = 10.0, endereco = {rua = "R", cidade = "Santos", uf = "SP"}},
            {nome = "Bia", saldo = 20.0, endereco = {rua = "R", cidade = "Rio", uf = "RJ"}},
            {nome = "Caio", saldo = 30.0, endereco = {rua = "R", cidade = "Campinas", uf = "SP"}},
        ]))
        _ = t.no_error(pedidos:insert_many([
            {cliente_id = 1, produto = "Mouse", valor = 50.0, pago = true},
            {cliente_id = 1, produto = "Monitor", valor = 900.0},
            {cliente_id = 2, produto = "Teclado", valor = 200.0, pago = true},
        ]))
        local function check()
            -- inner join, filtered on both tables, ordered by a joined field
            local rows = t.no_error(model:join(Pedidos, "p", "p.cliente_id = id")
                :where("p.valor > ? and endereco.uf = ?", 40, "SP"):order_by("-p.valor"):all())
            t.eq(len(rows), 2)
            t.eq(rows[0].nome, "Ana")
            t.eq(rows[0].p.produto, "Monitor")
            t.eq(rows[0].p.pago, false)
            t.eq(rows[1].p.produto, "Mouse")

            -- left join keeps Caio, with no pedido; aggregates over the join
            rows = t.no_error(model:left_join(pedidos, "p", "p.cliente_id = id")
                :group_by("nome"):aggregate({n = "count(p.id)", total = "sum(p.valor)"})
                :order_by("nome"):all())
            t.eq(len(rows), 3)
            t.eq(rows[0].total, 950.0)
            t.eq(rows[1].n, 1)
            t.eq(rows[2].nome, "Caio")
            t.eq(rows[2].n, 0)
            t.is_nil(rows[2].total)

            rows = t.no_error(model:left_join(Pedidos, "p", "p.cliente_id = id")
                :where("p.id", nil):fields("nome", "p.produto"):all())
            t.eq(len(rows), 1)
            t.eq(rows[0].nome, "Caio")
            t.is_nil(rows[0].p)
            t.is_nil(rows[0].saldo)

            rows = t.no_error(model:join(Pedidos, "p", "p.cliente_id = id")
                :where("p.pago", true):or_where("nome", "Ana"):fields("nome", "p"):order_by("p.valor"):all())
            t.eq(len(rows), 3)
            t.eq(rows[0].p.produto, "Mouse")
            t.eq(rows[2].p.valor, 900.0)
            t.eq(rows[2].p.cliente_id, 1)

            t.eq(t.no_error(model:join(Pedidos, "p", "p.cliente_id = id"):count()), 3)
            t.eq(t.no_error(model:join(Pedidos, "p", "p.cliente_id = id"):sum("p.valor")), 1150.0)
        end
        t.eq(model.conn.joins, true)
        check()
        model.conn.joins = false
        check()

        t.is_error(model:join(Pedidos, "p", "p.cliente = id"):all(), "unknown field 'pedidos.cliente'")
        t.is_error(model:join(Pedidos, "nome", "nome.cliente_id = id"):all(), "already a field")
        t.is_error(model:join(Pedidos, "p", "p.cliente_id > id"):all(), "expected field = field")
        t.is_error(model:where("p.valor", 1):join(Pedidos, "p", "p.cliente_id = id"):all(), "unknown field")
        t.is_error(model:join(Pedidos, "p", "p.cliente_id = id"):where("p.pago", true):delete(), "does not take joins")
    end)

    t.it("runs raw SQL: statements, model rows and rdd.raw conditions", function()
        local _ = t.no_error(model:insert_many([
            {nome = "Ana", email = "a@x.com", saldo = 10.0, endereco = {rua = "R", cidade = "Santos", uf = "SP"}},
            {nome = "bia", saldo = 20.0, ativo = false, endereco = {rua = "R", cidade = "Rio", uf = "RJ"}},
        ]))
        local rows = t.no_error(db:raw("SELECT nome, length(nome) AS n FROM clientes WHERE nome <> ? AND nome <> '?' ORDER BY id", "x"))
        t.eq(rows, [{nome = "Ana", n = 3}, {nome = "bia", n = 3}])
        t.eq(t.no_error(db:exec("UPDATE clientes SET nome = upper(nome) WHERE id = ?", 2)), 1)

        -- model:raw hydrates: ativo is a bool, endereco a document
        local docs = t.no_error(model:raw("SELECT * FROM clientes WHERE ativo = ?", 0))
        t.eq(len(docs), 1)
        t.eq(docs[0].nome, "BIA")
        t.eq(docs[0].ativo, false)
        t.eq(docs[0].endereco.uf, "RJ")

        rows = t.no_error(model:where("ativo", false):or_where(rdd.raw("upper(nome) = ?", "ANA")):order_by("nome"):all())
        t.eq(len(rows), 2)
        t.eq(t.no_error(model:where(rdd.raw("saldo * 2 > ?", 30)):count()), 1)

        local st = t.no_error(rdd.sql.find(Clientes, t.no_error(model:where("nome", "x"):where(rdd.raw("tags ?? ?", "vip")):to_plan()),
            rdd.sql.dialects.postgres))
        t.eq(st.sql, "SELECT * FROM \"clientes\" WHERE \"nome\" = $1 AND (tags ? $2)")

        t.is_error(db:raw("SELECT ? AS a", 1, 2), "more values than '?'")
        t.is_error(db:raw("SELECT ? AS a"), "more '?' than values")
        model.conn.raw = false
        t.is_error(model:where(rdd.raw("1 = 1")):all(), "needs a SQL driver")
    end)

    t.it("saves with upsert and with the lookup fallback", function()
        local function check_save()
            local a = t.no_error(model:save({nome = "Ana", email = "a@x.com", saldo = 1.0}))
            t.not_nil(a.id)
            t.no_error(model:save({id = a.id, nome = "Ana B", email = "a@x.com", saldo = 2.0}))
            t.no_error(model:save({id = 99, nome = "Nova", email = "n@x.com"}))
            t.eq(t.no_error(model:count()), 2)
            local ana = t.no_error(model:find(a.id))
            t.eq(ana.nome, "Ana B")
            t.eq(ana.saldo, 2.0)
            t.eq(t.no_error(model:find(99)).ativo, true)
            t.no_error(model:query():delete())
        end
        t.eq(type(model.conn.upsert), "function")
        check_save()
        model.conn.upsert = nil
        check_save()
    end)

    t.it("supports transactions and rolls back on error", function()
        local _ = t.no_error(model:insert({
            nome = "Daniel",
            email = "daniel@example.com",
            saldo = 1000.0,
        }))

        local res = db:transaction(function(tx)
            local tx_clientes = tx:model(Clientes)
            local _ = tx_clientes:insert({
                nome = "Temp User",
                email = "temp@example.com",
            })?
            return error("abort transaction")
        end)
        t.is_error(res, "abort transaction")
        t.eq(t.no_error(model:count()), 1)
    end)
end)
