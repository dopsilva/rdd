-- query — fluent query builder and abstract query plan (AST) for RDD
--
-- Builds a driver-independent query plan:
--   {
--       collection = "clientes",
--       schema     = <Schema>,
--       fields     = ["id", "nome"],
--       filters    = [
--           {kind = "cond", logic = "and", field = "ativo", op = "=", value = true},
--           {kind = "group", logic = "or", filters = [...]},
--       ],
--       orders     = [{field = "nome", dir = "asc"}],
--       limit      = 10,
--       offset     = 0,
--   }
--
-- After aggregate() the plan also has
--       group_by   = ["endereco.uf"],
--       aggregates = [{name = "total", fn = "sum", field = "saldo"}],  -- field nil: count(*)
-- and the query returns one row per group; limit, offset and orders (which
-- may name an aggregate) then apply to the groups.
--
-- After join()/left_join() it has
--       joins = [{kind = "inner", alias = "p", collection = "pedidos", schema = <Schema>,
--                 on = [{left = "p.cliente_id", right = "id"}]}],
-- and paths starting with an alias ("p.valor") name the joined schema's fields.

local M = {}

local VALID_OPS = {
    ["="] = true,
    ["!="] = true,
    ["<"] = true,
    ["<="] = true,
    [">"] = true,
    [">="] = true,
    ["in"] = true,
    not_in = true,
    is_null = true,
    is_not_null = true,
    between = true,
    like = true,
    ilike = true,
    contains = true,
    starts_with = true,
    ends_with = true,
}

local Query = {}

local function is_record(v)
    local t = type(v)
    return t == "table" or t == "struct" or t == "map"
end

local function with_methods(obj, methods)
    for k, f in methods do obj[k] = f end
    return obj
end

-- resolve(joins, schema, path) → join | nil, schema, path inside that schema
-- A path starting with a join's alias ("p.valor") names a field of the
-- joined schema; any other path is a field of the query's own schema.
local function resolve(joins, schema, path)
    local dot = string.find(path, ".")
    if dot ~= nil and joins ~= nil then
        local alias = string.sub(path, 1, dot - 1)
        for _, j in joins do
            if j.alias == alias then return j, j.schema, string.sub(path, dot + 1) end
        end
    end
    return nil, schema, path
end
M.resolve = resolve

local function check_field(q, field_path)
    if type(field_path) ~= "string" or string.trim(field_path) == "" then
        return error("rdd: query field name must be a non-empty string")
    end
    local _, schema, path = resolve(q._joins, q.schema, field_path)
    if schema ~= nil and not schema.allow_extra then
        if schema:field_at(path) == nil then
            return error(`rdd: unknown field '${schema.name}.${path}' in query`)
        end
    end
    return true
end

local function clone_filters(filters)
    local out = []
    for _, f in filters do
        local c = {}
        c.kind = f.kind
        c.logic = f.logic
        if f.kind == "group" then
            c.filters = clone_filters(f.filters)
        elseif f.kind == "raw" then
            c.sql = f.sql
            c.values = f.values
        else
            c.field = f.field
            c.op = f.op
            c.value = f.value
        end
        out[] = c
    end
    return out
end

-- operator spellings accepted in where(field, op, value), lowercased with
-- spaces collapsed, mapped to the plan's operator names
local OP_ALIASES = {
    ["=="] = "=", ["~="] = "!=", ["<>"] = "!=",
    ["not in"] = "not_in", not_in = "not_in",
    ["starts with"] = "starts_with", ["ends with"] = "ends_with",
    ["is null"] = "is_null", ["is not null"] = "is_not_null",
}

local function add_condition(q, logic, a, b, c, nargs, d)
    if q._err ~= nil then return q end

    -- Grouped sub-query: q:where(function(sub) ... end)
    if nargs == 1 and type(a) == "function" then
        local sub = M.new(q.schema, q.conn)
        sub._joins = q._joins
        local r = a(sub)
        if is_error(r) then
            q._err = r
            return q
        end
        if sub._err ~= nil then
            q._err = sub._err
            return q
        end
        if len(sub._filters) > 0 then
            local g = {}
            g.kind = "group"
            g.logic = logic
            g.filters = clone_filters(sub._filters)
            q._filters[] = g
        end
        return q
    end

    -- Equality map/table shorthand: q:where({ativo = true, uf = ["SP", "RJ"]})
    -- (an array value means in)
    if nargs == 1 and is_record(a) then
        local keys = list.keys(a)
        for i, k in keys do
            local item_logic = (i == 0) and logic or "and"
            add_condition(q, item_logic, k, type(a[k]) == "array" and "in" or "=", a[k], 3)
            if q._err ~= nil then return q end
        end
        return q
    end

    local field = a
    local op = "="
    local val = b
    if nargs >= 3 then
        op = b
        val = c
    elseif nargs < 2 then
        q._err = error("rdd: where() requires (table), (fn), (field, value), or (field, op, value)")
        return q
    end

    if type(op) == "string" then
        op = string.lower(string.trim(re.gsub("\\s+", op, " ")))
        op = OP_ALIASES[op] or op
    end
    -- where("saldo", "between", 400, 1500)
    if op == "between" and nargs == 4 then val = [c, d] end
    if nargs == 4 and op ~= "between" then
        q._err = error(`rdd: where('${tostring(field)}', '${op}', ...) takes one value; only between takes two`)
        return q
    end
    -- comparing with nil means a null test, so drivers need no special case
    if val == nil and op == "=" then op = "is_null" end
    if val == nil and op == "!=" then op = "is_not_null" end
    if type(op) ~= "string" or not VALID_OPS[op] then
        q._err = error(`rdd: invalid query operator '${tostring(op)}'`)
        return q
    end

    local ok = check_field(q, field)
    if is_error(ok) then
        q._err = ok
        return q
    end

    if (op == "in" or op == "not_in") and type(val) ~= "array" then
        q._err = error(`rdd: operator '${op}' on '${field}' requires an array value`)
        return q
    end
    if op == "between" and (type(val) ~= "array" or len(val) ~= 2) then
        q._err = error(`rdd: operator 'between' on '${field}' requires a 2-element array [low, high]`)
        return q
    end

    local node = {}
    node.kind = "cond"
    node.logic = logic
    node.field = field
    node.op = op
    node.value = val
    q._filters[] = node
    return q
end

-- ---- condition expressions ----
--
-- q:where("(campo = ? or campo2 = ?) and campo3 = ?", "A", "B", "C"): the
-- expression is parsed into the same plan nodes as the fluent calls, with
-- the fields checked against the schema. Values are `?` placeholders (taken
-- in order) or literals: 'text' (two quotes for one), numbers, true, false.
-- Conditions: field op value with op one of = == != <> < <= > >= like ilike
-- contains starts_with ends_with; field [not] in (v, ...) or field [not] in
-- ? (an array); field between v and v; field is [not] null. and binds
-- tighter than or; parentheses group. Keywords in any case.

local KEYWORDS = {
    ["and"] = true, ["or"] = true, ["not"] = true, ["in"] = true, is = true, null = true,
    between = true, like = true, ilike = true, contains = true, starts_with = true, ends_with = true,
    ["true"] = true, ["false"] = true,
}

-- the tokens of an expression: {kind = "name"|"kw"|"op"|"num"|"str"|"ph"|"(" |")"|",", text}
local function tokenize(src)
    local toks = []
    local i = 1
    local n = len(src)
    while i <= n do
        local c = string.sub(src, i, i)
        if c == " " or c == "\t" or c == "\n" or c == "\r" then
            i += 1
        elseif c == "(" or c == ")" or c == "," then
            toks[] = {kind = c, text = c}
            i += 1
        elseif c == "?" then
            toks[] = {kind = "ph", text = "?"}
            i += 1
        elseif c == "'" then
            local j = i + 1
            local parts = []
            while true do
                if j > n then return error(`rdd: unterminated string in '${src}'`) end
                local d = string.sub(src, j, j)
                if d == "'" then
                    if string.sub(src, j + 1, j + 1) == "'" then
                        parts[] = "'"
                        j += 2
                    else
                        break
                    end
                else
                    parts[] = d
                    j += 1
                end
            end
            toks[] = {kind = "str", text = string.join(parts, "")}
            i = j + 1
        else
            local m = re.match("^(<=|>=|<>|!=|==|=|<|>)", string.sub(src, i))
            if m ~= nil then
                toks[] = {kind = "op", text = m.text}
                i += len(m.text)
            else
                m = re.match("^-?[0-9]+(\\.[0-9]+)?", string.sub(src, i))
                if m ~= nil then
                    toks[] = {kind = "num", text = m.text}
                    i += len(m.text)
                else
                    m = re.match("^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*", string.sub(src, i))
                    if m == nil then return error(`rdd: unexpected '${c}' in '${src}'`) end
                    local low = string.lower(m.text)
                    if KEYWORDS[low] then
                        toks[] = {kind = "kw", text = low}
                    else
                        toks[] = {kind = "name", text = m.text}
                    end
                    i += len(m.text)
                end
            end
        end
    end
    return toks
end

-- parse an expression into a tree: {type = "or"|"and", items} or {type = "cond", field, op, value}
local function parse_expr(src, params)
    local toks = tokenize(src)?
    local pos = 0
    local next_param = 0
    local function peek() return pos < len(toks) and toks[pos] or nil end
    local function is_kw(t, w) return t ~= nil and t.kind == "kw" and t.text == w end
    local function fail(msg)
        local t = peek()
        return error(`rdd: ${msg} ${t ~= nil and ("at '" .. t.text .. "'") or "at the end"} in '${src}'`)
    end
    local function value()
        local t = peek()
        if t == nil then return fail("expected a value") end
        pos += 1
        if t.kind == "ph" then
            if next_param >= len(params) then return error(`rdd: more '?' than values in '${src}'`) end
            local v = params[next_param]
            next_param += 1
            return {v = v}
        elseif t.kind == "str" then
            return {v = t.text}
        elseif t.kind == "num" then
            return {v = string.contains(t.text, ".") and tonumber(t.text) or math.floor(tonumber(t.text))}
        elseif is_kw(t, "true") then
            return {v = true}
        elseif is_kw(t, "false") then
            return {v = false}
        end
        pos -= 1
        return fail("expected a value")
    end
    local function cond()
        local t = peek()
        if t == nil or t.kind ~= "name" then return fail("expected a field name") end
        pos += 1
        local field = t.text
        local o = peek()
        if o == nil then return fail("expected an operator") end
        if o.kind == "op" then
            pos += 1
            local op = o.text
            if op == "==" then op = "=" end
            if op == "<>" then op = "!=" end
            local v = value()?
            return {type = "cond", field = field, op = op, value = v.v}
        end
        if is_kw(o, "is") then
            pos += 1
            local neg = false
            if is_kw(peek(), "not") then
                pos += 1
                neg = true
            end
            if not is_kw(peek(), "null") then return fail("expected null") end
            pos += 1
            return {type = "cond", field = field, op = neg and "is_not_null" or "is_null", value = nil}
        end
        local neg = false
        if is_kw(o, "not") then
            pos += 1
            neg = true
            o = peek()
        end
        if is_kw(o, "in") then
            pos += 1
            local vals = []
            if peek() ~= nil and peek().kind == "ph" then
                vals = value()?.v
            else
                if peek() == nil or peek().kind ~= "(" then return fail("expected '(' after in") end
                pos += 1
                while true do
                    vals[] = value()?.v
                    local s = peek()
                    if s ~= nil and s.kind == "," then
                        pos += 1
                    elseif s ~= nil and s.kind == ")" then
                        pos += 1
                        break
                    else
                        return fail("expected ',' or ')'")
                    end
                end
            end
            return {type = "cond", field = field, op = neg and "not_in" or "in", value = vals}
        end
        if neg then return fail("expected in after not") end
        if is_kw(o, "between") then
            pos += 1
            local lo = value()?
            if not is_kw(peek(), "and") then return fail("expected and in between") end
            pos += 1
            local hi = value()?
            return {type = "cond", field = field, op = "between", value = [lo.v, hi.v]}
        end
        if o.kind == "kw" and VALID_OPS[o.text] then
            pos += 1
            local v = value()?
            return {type = "cond", field = field, op = o.text, value = v.v}
        end
        return fail("expected an operator")
    end
    local or_expr = nil
    local function primary()
        local t = peek()
        if t ~= nil and t.kind == "(" then
            pos += 1
            local e = or_expr()?
            if peek() == nil or peek().kind ~= ")" then return fail("expected ')'") end
            pos += 1
            return e
        end
        if is_kw(t, "not") then return fail("not before a condition is not supported (use !=, not in, is not null)") end
        return cond()
    end
    local function and_expr()
        local items = [primary()?]
        while is_kw(peek(), "and") do
            pos += 1
            items[] = primary()?
        end
        return len(items) == 1 and items[0] or {type = "and", items = items}
    end
    or_expr = function()
        local items = [and_expr()?]
        while is_kw(peek(), "or") do
            pos += 1
            items[] = and_expr()?
        end
        return len(items) == 1 and items[0] or {type = "or", items = items}
    end
    local tree = or_expr()?
    if peek() ~= nil then return fail("unexpected") end
    if next_param < len(params) then return error(`rdd: more values than '?' in '${src}'`) end
    return tree
end

-- the tree's conditions added to q: an "and" list inline, an "or" list (and
-- anything inside it) as groups, so no driver has to know precedence
local function add_tree(q, logic, tree)
    if tree.type == "cond" then
        return add_condition(q, logic, tree.field, tree.op, tree.value, 3)
    end
    if tree.type == "and" then
        for i, item in tree.items do
            -- a cond, or an "or" list, which add_tree makes a group of
            add_tree(q, i == 0 and logic or "and", item)
            if q._err ~= nil then return q end
        end
        return q
    end
    -- or: one group holding the alternatives
    return add_condition(q, logic, function(sub)
        for i, item in tree.items do
            local l = i == 0 and "and" or "or"
            if item.type == "cond" then
                add_condition(sub, l, item.field, item.op, item.value, 3)
            else
                add_condition(sub, l, function(inner) add_tree(inner, "and", item) end, nil, nil, 1)
            end
            if sub._err ~= nil then return sub._err end
        end
    end, nil, nil, 1)
end

-- is this where() argument an expression rather than a field name?
local function is_expression(s)
    return type(s) == "string" and re.match("^\\s*[A-Za-z_][A-Za-z0-9_.]*\\s*$", s) == nil
end

local function add_expression(q, logic, src, params)
    if q._err ~= nil then return q end
    local tree = parse_expr(src, params)
    if is_error(tree) then
        q._err = tree
        return q
    end
    return add_tree(q, logic, tree)
end

-- ---- Query builder methods ----

-- q:clone() → independent copy of the query
function Query.clone(self)
    local c = M.new(self.schema, self.conn)
    c._err = self._err
    for _, f in self._fields do c._fields[] = f end
    c._filters = clone_filters(self._filters)
    for _, o in self._orders do
        c._orders[] = {field = o.field, dir = o.dir}
    end
    c._limit = self._limit
    c._offset = self._offset
    for _, f in self._group do c._group[] = f end
    for _, a in self._aggs do c._aggs[] = a end
    for _, j in self._joins do c._joins[] = j end
    return c
end

local function is_alias(q, name)
    for _, j in q._joins do
        if j.alias == name then return true end
    end
    return false
end

-- "p.cliente_id = id and p.loja = loja" → [{left, right}], each side a field
-- path checked against the query's schema or a join (the new one included)
local function parse_on(q, on)
    if type(on) ~= "string" then
        return error("rdd: join condition must be a string like \"p.cliente_id = id\"")
    end
    local out = []
    for _, part in re.split("(?i)\\s+and\\s+", string.trim(on)) do
        local m = re.captures("^\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*==?\\s*([A-Za-z_][A-Za-z0-9_.]*)\\s*$", part)
        if m == nil then
            return error(`rdd: join condition '${on}': expected field = field [and field = field ...]`)
        end
        check_field(q, m[1])?
        check_field(q, m[2])?
        out[] = {left = m[1], right = m[2]}
    end
    return out
end

local function add_join(self, kind, target, alias, on)
    if self._err ~= nil then return self end
    local sch = target
    if is_record(target) and target.schema ~= nil and not target.__is_schema then sch = target.schema end
    if not is_record(sch) or not sch.__is_schema then
        self._err = error("rdd: join() expects a Schema (or a Model) to join")
        return self
    end
    if type(alias) ~= "string" or re.match("^[A-Za-z_][A-Za-z0-9_]*$", alias) == nil then
        self._err = error(`rdd: join alias must be a plain name, got '${tostring(alias)}'`)
        return self
    end
    if is_alias(self, alias) or (self.schema ~= nil and self.schema:field(alias) ~= nil) then
        self._err = error(`rdd: join alias '${alias}' is already a field or an alias of this query`)
        return self
    end
    local j = {}
    j.kind = kind
    j.alias = alias
    j.schema = sch
    j.collection = sch.name
    self._joins[] = j
    local conds = parse_on(self, on)
    if is_error(conds) then
        self._err = conds
        return self
    end
    j.on = conds
    return self
end

-- q:join(schema_or_model, alias, "alias.field = field [and ...]") — inner join
-- Fields of the joined schema are then named alias.field everywhere (where,
-- order_by, fields, group_by, aggregate), and each result document carries
-- the joined document under doc[alias].
function Query.join(self, target, alias, on)
    return add_join(self, "inner", target, alias, on)
end

-- q:left_join(...) — as join(), keeping documents without a match (doc[alias] is nil)
function Query.left_join(self, target, alias, on)
    return add_join(self, "left", target, alias, on)
end

-- query.raw(sql, values...) → a SQL condition to pass to where()/or_where()
-- (also rdd.raw). It goes into the query as written, in parentheses, its ?
-- taking the values as parameters (?? is a literal ?). The text is not
-- checked against the schema; with joins, name columns as the SQL does
-- ("p".valor). Only SQL drivers (conn.raw = true) run it.
function M.raw(sql, ...)
    local r = {}
    r.__raw = true
    r.sql = sql
    r.values = [...]
    return r
end

local function add_raw(q, logic, r)
    if q._err ~= nil then return q end
    if type(r.sql) ~= "string" or string.trim(r.sql) == "" then
        q._err = error("rdd: raw() expects a SQL condition string")
        return q
    end
    local node = {}
    node.kind = "raw"
    node.logic = logic
    node.sql = r.sql
    node.values = r.values
    q._filters[] = node
    return q
end

local function where_args(q, logic, args)
    if len(args) == 1 and is_record(args[0]) and args[0].__raw == true then return add_raw(q, logic, args[0]) end
    if is_expression(args[0]) then return add_expression(q, logic, args[0], list.slice(args, 1)) end
    return add_condition(q, logic, args[0], args[1], args[2], len(args), args[3])
end

-- q:where(...) adds a condition joined with and:
--   where("nome", "Ana")                        equality (a nil value: is null)
--   where("saldo", ">", 100)                    = != <> < <= > >= like ilike
--   where("uf", "in", ["SP", "RJ"])             in, not in, contains,
--                                               starts with, ends with
--   where("saldo", "between", 400, 1500)
--   where({ativo = true, uf = ["SP", "RJ"]})    equalities; an array is in
--   where("uf in ? and saldo > ?", ufs, 100)    an expression
--   where(function(g) g:where(...):or_where(...) end)   a group
--   where(rdd.raw("lower(nome) = ?", "ana"))    raw SQL
function Query.where(self, ...)
    return where_args(self, "and", [...])
end

-- q:and_where(...) — alias for where(...)
function Query.and_where(self, ...)
    return where_args(self, "and", [...])
end

-- q:or_where(...) — the same forms as where(), joined with or
function Query.or_where(self, ...)
    return where_args(self, "or", [...])
end

-- q:fields(f1, f2, ...) or q:fields(["f1", "f2"]) — projection
function Query.fields(self, ...)
    if self._err ~= nil then return self end
    local args = {...}
    if len(args) == 1 and type(args[0]) == "array" then
        args = args[0]
    end
    for _, f in args do
        -- a join's alias alone projects the whole joined document
        local ok = is_alias(self, f) or check_field(self, f)
        if is_error(ok) then
            self._err = ok
            return self
        end
        self._fields[] = f
    end
    return self
end

-- q:project(...) — alias for fields(...)
function Query.project(self, ...)
    return self.fields(self, ...)
end

-- q:order_by(field [, "asc"|"desc"]) — also accepts "-field" for desc
function Query.order_by(self, field, dir)
    if self._err ~= nil then return self end
    if type(field) ~= "string" or string.trim(field) == "" then
        self._err = error("rdd: order_by field must be a non-empty string")
        return self
    end
    if dir == nil then
        if string.starts_with(field, "-") then
            field = string.sub(field, 2)
            dir = "desc"
        elseif string.starts_with(field, "+") then
            field = string.sub(field, 2)
            dir = "asc"
        else
            dir = "asc"
        end
    else
        dir = string.lower(tostring(dir))
    end
    if dir ~= "asc" and dir ~= "desc" then
        self._err = error(`rdd: order_by direction must be 'asc' or 'desc', got '${dir}'`)
        return self
    end
    -- after aggregate(), an aggregate's name orders too
    local is_agg = false
    for _, a in self._aggs do
        if a.name == field then is_agg = true end
    end
    if not is_agg then
        local ok = check_field(self, field)
        if is_error(ok) then
            self._err = ok
            return self
        end
    end
    self._orders[] = {field = field, dir = dir}
    return self
end

-- q:group_by(f1, f2, ...) or q:group_by(["f1", "f2"]) — groups for aggregate()
function Query.group_by(self, ...)
    if self._err ~= nil then return self end
    local args = [...]
    if len(args) == 1 and type(args[0]) == "array" then args = args[0] end
    for _, f in args do
        local ok = check_field(self, f)
        if is_error(ok) then
            self._err = ok
            return self
        end
        self._group[] = f
    end
    return self
end

local AGG_FNS = {count = true, sum = true, avg = true, min = true, max = true}

-- q:aggregate({name = "fn(field)", ...}) — the query returns one row per
-- group (or a single row without group_by) holding the group_by fields and
-- each named aggregate: count(*), count(field), sum, avg, min, max. As in
-- SQL, nils are skipped, and sum/avg/min/max of no values are nil.
function Query.aggregate(self, specs)
    if self._err ~= nil then return self end
    if not is_record(specs) then
        self._err = error("rdd: aggregate() expects a table like {total = \"sum(saldo)\"}")
        return self
    end
    for _, name in list.keys(specs) do
        local spec = specs[name]
        local m = type(spec) == "string" and re.captures("^\\s*([A-Za-z_]+)\\s*\\(\\s*([A-Za-z0-9_.]+|\\*)\\s*\\)\\s*$", spec) or nil
        if m == nil or not AGG_FNS[string.lower(m[1])] then
            self._err = error(`rdd: aggregate '${name}': expected count(*) or count/sum/avg/min/max(field), got '${tostring(spec)}'`)
            return self
        end
        local fn = string.lower(m[1])
        local field = m[2]
        if field == "*" then
            if fn ~= "count" then
                self._err = error(`rdd: aggregate '${name}': only count takes *`)
                return self
            end
            field = nil
        else
            local ok = check_field(self, field)
            if is_error(ok) then
                self._err = ok
                return self
            end
        end
        self._aggs[] = {name = name, fn = fn, field = field}
    end
    return self
end

-- q:limit(n)
function Query.limit(self, n)
    if self._err ~= nil then return self end
    if type(n) ~= "int" or n < 0 then
        self._err = error(`rdd: limit must be a non-negative int, got ${tostring(n)}`)
        return self
    end
    self._limit = n
    return self
end

-- q:offset(n)
function Query.offset(self, n)
    if self._err ~= nil then return self end
    if type(n) ~= "int" or n < 0 then
        self._err = error(`rdd: offset must be a non-negative int, got ${tostring(n)}`)
        return self
    end
    self._offset = n
    return self
end

-- A list where an "and" follows an "or" (where(a):or_where(b):where(c))
-- reads one way with SQL precedence, a or (b and c), and another left to
-- right, (a or b) and c. The plan takes the SQL reading and makes it
-- explicit: each run of "and" conditions becomes a group, so every driver
-- evaluates it the same way. Lists without that mix are left as they are.
local function canonical(filters)
    local out = []
    for _, f in filters do
        if f.kind == "group" then
            local g = {}
            g.kind = "group"
            g.logic = f.logic
            g.filters = canonical(f.filters)
            out[] = g
        else
            out[] = f
        end
    end
    local seen_or = false
    local mixed = false
    for i, f in out do
        if i > 0 then
            if f.logic == "or" then
                seen_or = true
            elseif seen_or then
                mixed = true
            end
        end
    end
    if not mixed then return out end
    local runs = []
    for i, f in out do
        if i == 0 or f.logic == "or" then runs[] = [] end
        runs[-1][] = f
    end
    local result = []
    for k, run in runs do
        local logic = k == 0 and "and" or "or"
        if len(run) == 1 then
            run[0].logic = logic
            result[] = run[0]
        else
            run[0].logic = "and"
            local g = {}
            g.kind = "group"
            g.logic = logic
            g.filters = run
            result[] = g
        end
    end
    return result
end

-- q:to_plan() → abstract query plan table | error
function Query.to_plan(self)
    if self._err ~= nil then return self._err end
    local plan = {}
    plan.collection = self.schema and self.schema.name or nil
    plan.schema = self.schema
    local fields = []
    for _, f in self._fields do fields[] = f end
    plan.fields = fields
    plan.filters = canonical(clone_filters(self._filters))
    local orders = []
    for _, o in self._orders do orders[] = {field = o.field, dir = o.dir} end
    plan.orders = orders
    plan.limit = self._limit
    plan.offset = self._offset
    if len(self._aggs) > 0 then
        local group = []
        for _, f in self._group do group[] = f end
        plan.group_by = group
        local aggs = []
        for _, a in self._aggs do aggs[] = {name = a.name, fn = a.fn, field = a.field} end
        plan.aggregates = aggs
    elseif len(self._group) > 0 then
        return error("rdd: group_by() needs aggregate() to say what each group computes")
    end
    if len(self._joins) > 0 then
        local joins = []
        for _, j in self._joins do
            local on = []
            for _, c in j.on do on[] = {left = c.left, right = c.right} end
            joins[] = {kind = j.kind, alias = j.alias, collection = j.collection, schema = j.schema, on = on}
        end
        plan.joins = joins
    end
    return plan
end

local function get_path(doc, path)
    local v = doc
    for _, p in string.split(path, ".") do
        if not is_record(v) then return nil end
        v = v[p]
    end
    return v
end
M.get_path = get_path

local function compare(a, b)
    if a == b then return 0 end
    if a == nil then return -1 end
    if b == nil then return 1 end
    if type(a) == "bool" then a = a and 1 or 0 end
    if type(b) == "bool" then b = b and 1 or 0 end
    return a < b and -1 or 1
end

-- rows ordered by plan.orders (get(row, field) reads a value), then paged
local function order_and_page(rows, plan, get)
    if len(plan.orders) > 0 then
        sort.sort(rows, function(x, y)
            for _, o in plan.orders do
                local c = compare(get(x, o.field), get(y, o.field))
                if c ~= 0 then
                    if o.dir == "desc" then return c > 0 end
                    return c < 0
                end
            end
            return false
        end)
    end
    local from = plan.offset or 0
    if from == 0 and plan.limit == nil then return rows end
    local to = plan.limit ~= nil and math.min(from + plan.limit, len(rows)) or len(rows)
    if from >= to then return [] end
    return list.slice(rows, from, to)
end

-- query.aggregate_rows(docs, plan) → rows
-- Groups and aggregates documents in memory, then orders and pages the
-- groups: what q:aggregate() does with a driver that has no aggregate().
function M.aggregate_rows(docs, plan)
    local groups = []
    local by_key = [=]
    for _, d in docs do
        local vals = []
        for _, f in plan.group_by do vals[] = get_path(d, f) end
        local key = json.encode(vals)
        local g = by_key[key]
        if g == nil then
            g = {}
            g.vals = vals
            g.docs = []
            by_key[key] = g
            groups[] = g
        end
        g.docs[] = d
    end
    if len(groups) == 0 and len(plan.group_by) == 0 then
        local g = {}
        g.vals = []
        g.docs = []
        groups[] = g
    end
    local rows = []
    for _, g in groups do
        local row = {}
        for i, f in plan.group_by do row[f] = g.vals[i] end
        for _, a in plan.aggregates do
            local n = 0
            local acc = nil
            for _, d in g.docs do
                local v = a.field == nil and true or get_path(d, a.field)
                if v ~= nil then
                    n += 1
                    if a.fn == "sum" or a.fn == "avg" then
                        acc = (acc or 0) + v
                    elseif a.fn == "min" then
                        if acc == nil or compare(v, acc) < 0 then acc = v end
                    elseif a.fn == "max" then
                        if acc == nil or compare(v, acc) > 0 then acc = v end
                    end
                end
            end
            if a.fn == "count" then
                row[a.name] = n
            elseif a.fn == "avg" then
                row[a.name] = n > 0 and acc / n or nil
            else
                row[a.name] = acc
            end
        end
        rows[] = row
    end
    -- aggregate rows are flat: "endereco.uf" is one key
    return order_and_page(rows, plan, function(r, f) return r[f] end)
end

-- ---- In-memory evaluation (drivers without joins) ----

local function like_regex(pattern, icase)
    local rx = re.escape(tostring(pattern))
    rx = string.replace(rx, "%", ".*")
    rx = string.replace(rx, "_", ".")
    return (icase and "(?is)^" or "(?s)^") .. rx .. "$"
end

local function comparable(a, b)
    local ta = type(a)
    local tb = type(b)
    if ta == tb then return ta ~= "nil" end
    return (ta == "int" or ta == "number") and (tb == "int" or tb == "number")
end

local function match_cond(doc, node)
    local v = get_path(doc, node.field)
    local op = node.op
    local x = node.value
    if op == "is_null" then return v == nil end
    if op == "is_not_null" then return v ~= nil end
    -- as in SQL, any other test on a missing value is false
    if v == nil then return false end
    if op == "=" then return v == x end
    if op == "!=" then return v ~= x end
    if op == "in" then return list.contains(x, v) end
    if op == "not_in" then return not list.contains(x, v) end
    if op == "between" then
        return comparable(v, x[0]) and comparable(v, x[1]) and compare(v, x[0]) >= 0 and compare(v, x[1]) <= 0
    end
    if op == "<" or op == "<=" or op == ">" or op == ">=" then
        if not comparable(v, x) then return false end
        local c = compare(v, x)
        if op == "<" then return c < 0 end
        if op == "<=" then return c <= 0 end
        if op == ">" then return c > 0 end
        return c >= 0
    end
    local s = tostring(v)
    if op == "like" then return re.match(like_regex(x, false), s) ~= nil end
    if op == "ilike" then return re.match(like_regex(x, true), s) ~= nil end
    if op == "contains" then return string.contains(s, tostring(x)) end
    if op == "starts_with" then return string.starts_with(s, tostring(x)) end
    if op == "ends_with" then return string.ends_with(s, tostring(x)) end
    return false
end

-- query.match(doc, filters) → bool
-- Evaluates plan filters (canonical: and/or mixes are grouped) on a document;
-- for drivers that filter in memory, and the in-memory join.
function M.match(doc, filters)
    local result = true
    for i, node in filters do
        local v
        if node.kind == "group" then
            v = M.match(doc, node.filters)
        else
            v = match_cond(doc, node)
        end
        if i == 0 then
            result = v
        elseif node.logic == "or" then
            result = result or v
        else
            result = result and v
        end
    end
    return result
end

local function copy_doc(d)
    local out = {}
    for k, v in d do out[k] = v end
    return out
end

local function simple_plan(schema, filters)
    local p = {}
    p.collection = schema.name
    p.schema = schema
    p.fields = []
    p.filters = filters
    p.orders = []
    p.limit = nil
    p.offset = nil
    return p
end

-- the join aliases a filter node touches ("" for the query's own schema)
local function node_aliases(joins, node, out)
    if node.kind == "group" then
        for _, n in node.filters do node_aliases(joins, n, out) end
    elseif node.kind == "raw" then
        out["(raw)"] = true -- never pushed down
    else
        local j = resolve(joins, nil, node.field)
        out[j and j.alias or ""] = true
    end
    return out
end

local function strip_alias(node, alias)
    local c = {}
    c.kind = node.kind
    c.logic = "and"
    if node.kind == "group" then
        c.filters = []
        for i, n in node.filters do
            local s = strip_alias(n, alias)
            s.logic = i == 0 and "and" or n.logic
            c.filters[] = s
        end
    else
        c.field = string.sub(node.field, len(alias) + 2)
        c.op = node.op
        c.value = node.value
    end
    return c
end

-- The filters that can go to one table's find() ahead of the join: top-level
-- and-terms touching only that table (for a joined table, only an inner
-- join, where a missing match drops the row anyway). They narrow the reads;
-- the whole filter still runs on the joined rows.
local function pushdown(plan, alias)
    for i, node in plan.filters do
        if i > 0 and node.logic == "or" then return [] end
    end
    local out = []
    for _, node in plan.filters do
        local touched = node_aliases(plan.joins, node, [=])
        local keys = list.keys(touched)
        if len(keys) == 1 and keys[0] == alias then
            if alias == "" then
                out[] = node
            else
                out[] = strip_alias(node, alias)
            end
        end
    end
    return out
end

local function on_value(row, j, jdoc, path)
    local prefix = j.alias .. "."
    if string.starts_with(path, prefix) then return get_path(jdoc, string.sub(path, len(prefix) + 1)) end
    return get_path(row, path)
end

-- the projected fields of a joined row: as rdd/sql selects them, a nested
-- path keeps its whole root field and "p.valor" keeps doc.p.valor
local function project(row, fields, joins)
    local out = {}
    for _, f in fields do
        local j, _, rest = resolve(joins, nil, f)
        if j ~= nil then
            local sub = row[j.alias]
            if sub ~= nil then
                if out[j.alias] == nil then out[j.alias] = {} end
                local root = string.split(rest, ".")[0]
                out[j.alias][root] = sub[root]
            end
        else
            -- a field of the query's schema, or a join's alias alone
            local root = string.split(f, ".")[0]
            out[root] = row[root]
        end
    end
    return out
end

-- query.join_rows(conn, plan) → array of docs | error
-- Runs a plan with joins on a driver that only knows find(): reads each
-- table, joins in memory (nested loops), filters, then aggregates or
-- orders, pages and projects.
function M.join_rows(conn, plan)
    local docs = conn:find(plan.schema, simple_plan(plan.schema, pushdown(plan, "")))?
    local rows = []
    for _, d in docs do rows[] = copy_doc(d) end
    for _, j in plan.joins do
        local jf = j.kind == "inner" and pushdown(plan, j.alias) or []
        local jdocs = conn:find(j.schema, simple_plan(j.schema, jf))?
        local joined = []
        for _, r in rows do
            local matched = false
            for _, jd in jdocs do
                local ok = true
                for _, c in j.on do
                    local a = on_value(r, j, jd, c.left)
                    local b = on_value(r, j, jd, c.right)
                    if a == nil or b == nil or a ~= b then
                        ok = false
                        break
                    end
                end
                if ok then
                    local nr = copy_doc(r)
                    nr[j.alias] = jd
                    joined[] = nr
                    matched = true
                end
            end
            if not matched and j.kind == "left" then joined[] = copy_doc(r) end
        end
        rows = joined
    end
    local kept = []
    for _, r in rows do
        if M.match(r, plan.filters) then kept[] = r end
    end
    if plan.aggregates ~= nil then return M.aggregate_rows(kept, plan) end
    kept = order_and_page(kept, plan, get_path)
    if len(plan.fields) == 0 then return kept end
    local out = []
    for _, r in kept do out[] = project(r, plan.fields, plan.joins) end
    return out
end

-- q:ast() — alias for to_plan()
function Query.ast(self)
    return self:to_plan()
end

-- ---- Terminal execution methods (require a bound driver connection) ----

local function has_raw(filters)
    for _, f in filters do
        if f.kind == "raw" then return true end
        if f.kind == "group" and has_raw(f.filters) then return true end
    end
    return false
end

local function require_conn(self)
    if self._err ~= nil then return self._err end
    if self.conn == nil then
        return error("rdd: query is not bound to a database session")
    end
    -- only a driver that says so (conn.raw = true) gets raw SQL conditions
    if self.conn.raw ~= true and has_raw(self._filters) then
        return error("rdd: a raw() condition needs a SQL driver (conn.raw = true)")
    end
    return self.conn
end

-- q:all() → array of docs | error (aggregate rows after aggregate())
function Query.all(self)
    local conn = require_conn(self)?
    local plan = self:to_plan()?
    -- a driver takes plan.joins only when it says so (conn.joins = true)
    if plan.joins ~= nil and conn.joins ~= true then
        if has_raw(plan.filters) then return error("rdd: a raw() condition cannot run in an in-memory join") end
        return M.join_rows(conn, plan)
    end
    if plan.aggregates == nil then return conn:find(self.schema, plan) end
    if type(conn.aggregate) == "function" then return conn:aggregate(self.schema, plan) end
    local base = self:clone()
    base._aggs = []
    base._group = []
    base._orders = []
    base._fields = []
    base._limit = nil
    base._offset = nil
    local docs = conn:find(self.schema, base:to_plan()?)?
    return M.aggregate_rows(docs, plan)
end

-- q:first() → doc | nil | error
function Query.first(self)
    local c = self:clone():limit(1)
    local rows = c:all()?
    if len(rows) == 0 then return nil end
    return rows[0]
end

-- q:one() → doc | nil | error (returns error if more than 1 document matches)
function Query.one(self)
    local c = self:clone():limit(2)
    local rows = c:all()?
    if len(rows) == 0 then return nil end
    if len(rows) > 1 then
        return error(`rdd: expected at most one document from '${self.schema.name}', got multiple`)
    end
    return rows[0]
end

-- q:count() → int | error (the number of groups after aggregate())
function Query.count(self)
    local conn = require_conn(self)?
    local plan = self:to_plan()?
    if plan.aggregates ~= nil or (plan.joins ~= nil and conn.joins ~= true) then return len(self:all()?) end
    if type(conn.count) == "function" then
        return conn:count(self.schema, plan)
    end
    local rows = conn:find(self.schema, plan)?
    return len(rows)
end

-- q:exists() → bool | error
function Query.exists(self)
    local c = self:clone():limit(1)
    local n = c:count()?
    return n > 0
end

-- One aggregate over every matching document (group_by, orders and paging
-- left out).
local function scalar(self, fn, field)
    local c = self:clone()
    c._group = []
    c._aggs = []
    c._orders = []
    c._limit = nil
    c._offset = nil
    local rows = c:aggregate({value = `${fn}(${field})`}):all()?
    return rows[0].value
end

-- q:sum(field), q:avg(field), q:min(field), q:max(field) → value | nil | error
function Query.sum(self, field) return scalar(self, "sum", field) end
function Query.avg(self, field) return scalar(self, "avg", field) end
function Query.min(self, field) return scalar(self, "min", field) end
function Query.max(self, field) return scalar(self, "max", field) end

-- q:paginate(page, per_page) → {items, total, page, per_page, pages} | error
-- page counts from 1; total is the number of matching documents.
function Query.paginate(self, page, per_page)
    if type(page) ~= "int" or page < 1 or type(per_page) ~= "int" or per_page < 1 then
        return error(`rdd: paginate(page, per_page) expects ints >= 1, got ${tostring(page)}, ${tostring(per_page)}`)
    end
    local all = self:clone()
    all._limit = nil
    all._offset = nil
    local total = all:count()?
    local items = all:clone():limit(per_page):offset((page - 1) * per_page):all()?
    local out = {}
    out.items = items
    out.total = total
    out.page = page
    out.per_page = per_page
    out.pages = (total + per_page - 1) // per_page
    return out
end

-- q:each(fn) → int (rows visited) | error
function Query.each(self, fn)
    local rows = self:all()?
    local seen = 0
    for _, row in rows do
        seen += 1
        local r = fn(row)
        if is_error(r) then return r end
        if r == false then break end
    end
    return seen
end

-- q:update(changes) → updated_count (int) | error
function Query.update(self, changes)
    local conn = require_conn(self)?
    local plan = self:to_plan()?
    if plan.joins ~= nil then return error("rdd: update() does not take joins") end
    local valid_changes = self.schema:validate_changes(changes)?
    return conn:update(self.schema, plan, valid_changes)
end

-- q:delete() → deleted_count (int) | error
function Query.delete(self)
    local conn = require_conn(self)?
    local plan = self:to_plan()?
    if plan.joins ~= nil then return error("rdd: delete() does not take joins") end
    return conn:delete(self.schema, plan)
end

-- query.new(schema [, conn]) → Query
function M.new(schema, conn)
    local q = {}
    q.schema = schema
    q.conn = conn
    q._err = nil
    q._fields = []
    q._filters = []
    q._orders = []
    q._limit = nil
    q._offset = nil
    q._group = []
    q._aggs = []
    q._joins = []
    return with_methods(q, Query)
end

return M
