-- The driver suite (driver_suite.sea) on every driver: SQLite always,
-- CockroachDB and ClickHouse when their servers are given:
--   COCKROACH_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable \
--   CLICKHOUSE_URL=http://default:secret@localhost:8123/default \
--   ~/projects/sea_vm/bin/sea test drivers_test.sea
-- (the tests drop and create the tables clientes and pedidos)

local t = require("sea/test")
local sqlite = require("../sea_vm/libs/sqlite/sqlite")
local rdd = require("./rdd")
local suite = require("./driver_suite")

rdd.register_driver("suite_sqlite", {
    open = function(opts)
        local db = sqlite.open(":memory:")?
        return rdd.sql.connection(db, rdd.sql.dialects.sqlite)
    end,
})
rdd.register_driver("cockroach", require("./drivers/cockroach"))
rdd.register_driver("clickhouse", require("./drivers/clickhouse"))

suite.define(t, "sqlite", function() return rdd.open("suite_sqlite") end)

local crdb_url = os.getenv("COCKROACH_URL") or ""
if crdb_url ~= "" then
    suite.define(t, "cockroach", function() return rdd.open("cockroach", {url = crdb_url, max_conns = 4}) end)
else
    t.describe_skip("cockroach (COCKROACH_URL not set)", function() t.it("suite", function() end) end)
end

local ch_url = os.getenv("CLICKHOUSE_URL") or ""
if ch_url ~= "" then
    suite.define(t, "clickhouse", function() return rdd.open("clickhouse", {url = ch_url}) end, {transactions = false})
else
    t.describe_skip("clickhouse (CLICKHOUSE_URL not set)", function() t.it("suite", function() end) end)
end

t.describe("dialects", function()
    t.it("cockroach keeps PostgreSQL's SQL with its own types", function()
        local d = rdd.sql.dialects.cockroach
        t.eq(d.placeholder(2), "$2")
        t.matches(rdd.sql.create_table(suite.Pedidos, d), "\"id\" INT8 GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY")
        t.matches(rdd.sql.create_table(suite.Clientes, d), "\"endereco\" JSONB")
    end)

    t.it("clickhouse types its parameters from the values", function()
        local d = rdd.sql.dialects.clickhouse
        local plan = t.no_error(rdd.query(suite.Clientes):where("saldo", ">", 1):in("endereco.uf", ["SP"])
            :where("nome", "contains", "a_b"):where("ativo", true):to_plan())
        local st = t.no_error(rdd.sql.find(suite.Clientes, plan, d))
        local s, named = rdd.sql.clickhouse_params(st.sql, st.params)
        t.eq(s, "SELECT * FROM \"clientes\" WHERE \"saldo\" > {p1:Int64} AND JSON_VALUE(\"endereco\", '$.uf') IN ({p2:String})" ..
            " AND \"nome\" LIKE {p3:String} AND \"ativo\" = {p4:Bool}")
        t.eq(named, {p1 = 1, p2 = "SP", p3 = "%a\\_b%", p4 = true})
        local up = t.no_error(rdd.sql.update(suite.Clientes, t.no_error(rdd.query(suite.Clientes):where("id", 1):to_plan()),
            {["endereco.cidade"] = "It's"}, d))
        t.matches(up.sql, "jsonMergePatch\\(ifNull\\(\"endereco\", '\\{\\}'\\), '\\{\"cidade\":\"It\\\\'s\"\\}'\\)")
    end)
end)
