-- sql — compiles RDD query plans into parameterized SQL
--
-- Every SQL driver needs the same translation: plan filters into a WHERE
-- clause, orders, limit/offset, the INSERT/UPDATE/DELETE statements and a
-- CREATE TABLE from the schema. This module does it once; a dialect holds
-- what differs between engines (placeholders, identifier quoting, JSON paths
-- into document columns, ILIKE, paging, column types, how bools bind).
--
--   local sql = require("rdd/sql")         -- also rdd.sql
--   local d = sql.dialects.sqlite           -- or postgres, sqlserver, sql.dialect({...})
--   local st = sql.find(schema, plan, d)?    -- {sql = "...", params = [...]}
--   local rows = db:query(st.sql, st.params)?
--   for i, r in rows do rows[i] = sql.hydrate(schema, r, plan.fields, d) end
--
-- Values always travel as parameters. Identifiers come from the schema and
-- are quoted; LIKE patterns built by contains/starts_with/ends_with escape
-- their own % and _.

local query = require("./query")

local M = {}

local function is_record(v)
    local t = type(v)
    return t == "table" or t == "struct" or t == "map" or t == "array"
end

-- ---- Dialects ----

local function quote_with(open, close)
    return function(name)
        return open .. string.replace(name, close, close .. close) .. close
    end
end

local function sql_string(s)
    return "'" .. string.replace(s, "'", "''") .. "'"
end

local BASE = {
    name = "sql",
    placeholder = function(n) return "?" end,
    quote = quote_with("\"", "\""),
    has_ilike = false,
    -- bind(value, field) → the value handed to the database driver
    bind = function(v, f)
        if type(v) == "bool" then return v and 1 or 0 end
        if is_record(v) then return json.encode(v) end
        return v
    end,
    -- read(value, field) → the value put back into the document
    read = function(v, f)
        if v == nil or f == nil then return v end
        if f.type == "bool" and type(v) ~= "bool" then return v == 1 or v == "1" or v == "t" or v == "true" end
        if (f.type == "document" or f.type == "array" or f.type == "map") and type(v) == "string" then
            return json.decode(v)
        end
        return v
    end,
    -- json_get(column_sql, parts) → SQL reading a nested value as text
    json_get = function(col, parts)
        return `json_extract(${col}, ${sql_string("$." .. string.join(parts, "."))})`
    end,
    -- json_set(column_sql, parts, ph, value) → SQL for the new column value
    json_set = function(col, parts, ph, v)
        local arg = is_record(v) and `json(${ph})` or ph
        return `json_set(COALESCE(${col}, '{}'), ${sql_string("$." .. string.join(parts, "."))}, ${arg})`
    end,
    -- paging(sql, limit, offset, has_order) → sql with the limit/offset applied
    paging = function(s, limit, offset, has_order)
        if limit ~= nil then s ..= ` LIMIT ${limit}` end
        if offset ~= nil then
            if limit == nil then s ..= " LIMIT -1" end
            s ..= ` OFFSET ${offset}`
        end
        return s
    end,
    types = {
        string = "TEXT", int = "INTEGER", number = "REAL", bool = "INTEGER",
        bytes = "BLOB", time = "TEXT", uuid = "TEXT", any = "TEXT",
        map = "TEXT", document = "TEXT", array = "TEXT",
    },
    -- auto_pk(column_type) → column definition tail for an auto-increment int key
    auto_pk = function(t) return `${t} PRIMARY KEY AUTOINCREMENT` end,
    -- returning: INSERT ... RETURNING <pk> gives the generated key
    returning = false,
    -- create_table(quoted_name, name, columns_sql) → CREATE TABLE that skips an existing table
    create_table = function(qname, name, cols)
        return `CREATE TABLE IF NOT EXISTS ${qname} (${cols})`
    end,
    -- upsert(quoted_table, quoted_cols, placeholders, quoted_key) → insert, or update
    -- the other columns of the row whose key already exists
    upsert = function(qname, cols, phs, key)
        local sets = []
        for _, c in cols do
            if c ~= key then sets[] = `${c} = excluded.${c}` end
        end
        local tail = len(sets) == 0 and "DO NOTHING" or `DO UPDATE SET ${string.join(sets, ", ")}`
        return `INSERT INTO ${qname} (${string.join(cols, ", ")}) VALUES (${string.join(phs, ", ")}) ON CONFLICT (${key}) ${tail}`
    end,
}

-- sql.dialect(overrides [, base]) → dialect (missing entries come from base,
-- the generic SQLite-like dialect by default)
function M.dialect(over, base)
    base = base or BASE
    local d = {}
    for k, v in base do d[k] = v end
    local types = {}
    for k, v in base.types do types[k] = v end
    for k, v in over or {} do
        if k == "types" then
            for tk, tv in v do types[tk] = tv end
        else
            d[k] = v
        end
    end
    d.types = types
    return d
end

M.dialects = {}

M.dialects.sqlite = M.dialect({name = "sqlite"})

M.dialects.postgres = M.dialect({
    name = "postgres",
    placeholder = function(n) return `$${n}` end,
    has_ilike = true,
    bind = function(v, f)
        if is_record(v) then return json.encode(v) end
        return v
    end,
    json_get = function(col, parts)
        return `${col} #>> ${sql_string("{" .. string.join(parts, ",") .. "}")}`
    end,
    json_set = function(col, parts, ph, v)
        local path = sql_string("{" .. string.join(parts, ",") .. "}")
        return `jsonb_set(COALESCE(${col}, '{}'::jsonb), ${path}, ${ph}::jsonb)`
    end,
    -- json_value(v) → how a value set inside a document column is bound
    json_value = function(v) return json.encode(v) end,
    paging = function(s, limit, offset, has_order)
        if limit ~= nil then s ..= ` LIMIT ${limit}` end
        if offset ~= nil then s ..= ` OFFSET ${offset}` end
        return s
    end,
    types = {
        int = "BIGINT", number = "DOUBLE PRECISION", bool = "BOOLEAN",
        bytes = "BYTEA", time = "TIMESTAMPTZ", uuid = "UUID",
        map = "JSONB", document = "JSONB", array = "JSONB", any = "JSONB",
    },
    auto_pk = function(t) return "BIGSERIAL PRIMARY KEY" end,
    returning = true,
})

M.dialects.sqlserver = M.dialect({
    name = "sqlserver",
    placeholder = function(n) return `@p${n}` end,
    quote = quote_with("[", "]"),
    json_get = function(col, parts)
        return `JSON_VALUE(${col}, ${sql_string("$." .. string.join(parts, "."))})`
    end,
    json_set = function(col, parts, ph, v)
        local arg = is_record(v) and `JSON_QUERY(${ph})` or ph
        return `JSON_MODIFY(COALESCE(${col}, '{}'), ${sql_string("$." .. string.join(parts, "."))}, ${arg})`
    end,
    -- OFFSET/FETCH needs an ORDER BY
    paging = function(s, limit, offset, has_order)
        if limit == nil and offset == nil then return s end
        if not has_order then s ..= " ORDER BY (SELECT NULL)" end
        s ..= ` OFFSET ${offset or 0} ROWS`
        if limit ~= nil then s ..= ` FETCH NEXT ${limit} ROWS ONLY` end
        return s
    end,
    types = {
        string = "NVARCHAR(MAX)", int = "BIGINT", number = "FLOAT", bool = "BIT",
        bytes = "VARBINARY(MAX)", time = "DATETIMEOFFSET", uuid = "UNIQUEIDENTIFIER",
        map = "NVARCHAR(MAX)", document = "NVARCHAR(MAX)", array = "NVARCHAR(MAX)", any = "NVARCHAR(MAX)",
    },
    auto_pk = function(t) return `${t} IDENTITY(1,1) PRIMARY KEY` end,
    upsert = function(qname, cols, phs, key)
        local src = []
        local sets = []
        local vals = []
        for i, c in cols do
            src[] = `${phs[i]} AS ${c}`
            vals[] = `src.${c}`
            if c ~= key then sets[] = `${c} = src.${c}` end
        end
        local s = `MERGE INTO ${qname} AS dst USING (SELECT ${string.join(src, ", ")}) AS src ON dst.${key} = src.${key}`
        if len(sets) > 0 then s ..= ` WHEN MATCHED THEN UPDATE SET ${string.join(sets, ", ")}` end
        return s .. ` WHEN NOT MATCHED THEN INSERT (${string.join(cols, ", ")}) VALUES (${string.join(vals, ", ")});`
    end,
    create_table = function(qname, name, cols)
        return `IF OBJECT_ID(${"N" .. sql_string(name)}, N'U') IS NULL CREATE TABLE ${qname} (${cols})`
    end,
})

-- ---- Building blocks ----

-- A statement under construction: the parameters and their placeholders.
local function new_params(d)
    return {d = d, values = []}
end

local function add_param(p, v, f)
    p.values[] = p.d.bind(v, f)
    return p.d.placeholder(len(p.values))
end

-- What field paths refer to in a statement: the query's schema and, with
-- joins, the joined schemas by alias. With joins every column is qualified
-- (the base table by its name, a joined one by its alias).
local function scope(schema, plan, d)
    local s = {}
    s.schema = schema
    s.joins = plan and plan.joins or nil
    s.qualify = s.joins ~= nil
    s.base = d.quote(plan and plan.collection or schema.name)
    return s
end

local function col_of(S, path, d)
    local j, _, rest = query.resolve(S.joins, S.schema, path)
    local parts = string.split(rest, ".")
    local col = d.quote(parts[0])
    if S.qualify then col = (j ~= nil and d.quote(j.alias) or S.base) .. "." .. col end
    if len(parts) == 1 then return col end
    return d.json_get(col, list.slice(parts, 1))
end

local function field_in(S, path)
    local _, sch, rest = query.resolve(S.joins, S.schema, path)
    if sch == nil then return nil end
    return sch:field_at(rest)
end

-- sql.column(schema, path, d [, plan]) → SQL for a field path ("nome",
-- "endereco.uf", with joins "p.valor")
function M.column(schema, path, d, plan)
    return col_of(scope(schema, plan, d), path, d)
end

-- sql.field_at(schema, plan, path) → the field definition a path names
function M.field_at(schema, plan, path)
    local _, sch, rest = query.resolve(plan and plan.joins or nil, schema, path)
    if sch == nil then return nil end
    return sch:field_at(rest)
end

local function field_of(schema, path)
    if schema == nil then return nil end
    return schema:field_at(path)
end

local function like_escape(s)
    s = string.replace(s, "\\", "\\\\")
    s = string.replace(s, "%", "\\%")
    return string.replace(s, "_", "\\_")
end

local CMP = {["="] = "=", ["=="] = "=", ["!="] = "<>", ["<>"] = "<>", ["<"] = "<", ["<="] = "<=", [">"] = ">", [">="] = ">="}

local function compile_cond(S, node, p)
    local d = p.d
    local col = col_of(S, node.field, d)
    local f = field_in(S, node.field)
    local op = node.op
    local v = node.value
    if CMP[op] ~= nil then
        if v == nil then
            return (CMP[op] == "=") and `${col} IS NULL` or `${col} IS NOT NULL`
        end
        return `${col} ${CMP[op]} ${add_param(p, v, f)}`
    elseif op == "is_null" then
        return `${col} IS NULL`
    elseif op == "is_not_null" then
        return `${col} IS NOT NULL`
    elseif op == "in" or op == "not_in" then
        if len(v) == 0 then return (op == "in") and "1 = 0" or "1 = 1" end
        local ph = []
        for _, item in v do ph[] = add_param(p, item, f) end
        return `${col} ${(op == "in") and "IN" or "NOT IN"} (${string.join(ph, ", ")})`
    elseif op == "between" then
        local lo = add_param(p, v[0], f)
        return `${col} BETWEEN ${lo} AND ${add_param(p, v[1], f)}`
    elseif op == "like" then
        return `${col} LIKE ${add_param(p, v, f)}`
    elseif op == "ilike" then
        if d.has_ilike then return `${col} ILIKE ${add_param(p, v, f)}` end
        return `LOWER(${col}) LIKE LOWER(${add_param(p, v, f)})`
    elseif op == "contains" or op == "starts_with" or op == "ends_with" then
        local s = like_escape(tostring(v))
        if op ~= "starts_with" then s = "%" .. s end
        if op ~= "ends_with" then s ..= "%" end
        return `${col} LIKE ${add_param(p, s, nil)} ESCAPE '\\'`
    end
    return error(`rdd/sql: operator '${tostring(op)}' is not supported`)
end

local function compile_filters(S, filters, p)
    local out = []
    for _, node in filters do
        local s
        if node.kind == "group" then
            s = compile_filters(S, node.filters, p)?
            if s ~= "" then s = `(${s})` end
        else
            s = compile_cond(S, node, p)?
        end
        if s ~= "" then
            if len(out) > 0 then out[] = (node.logic == "or") and " OR " or " AND " end
            out[] = s
        end
    end
    return string.join(out, "")
end

local function where_clause(S, plan, p)
    local w = compile_filters(S, plan.filters or [], p)?
    return w ~= "" and ` WHERE ${w}` or ""
end

-- sql.where(schema, filters, d, params) → condition_sql | error
-- The bare condition (no WHERE keyword), for hand-written statements: its
-- values are appended to `params`, and placeholders number on from the
-- parameters already there.
function M.where(schema, filters, d, params)
    return compile_filters(scope(schema, nil, d), filters, {d = d, values = params})
end

-- FROM with the joins: "t" INNER JOIN "u" AS "p" ON "p"."k" = "t"."id" ...
local function from_clause(S, plan, d)
    local s = S.base
    for _, j in plan.joins or [] do
        local conds = []
        for _, c in j.on do conds[] = `${col_of(S, c.left, d)} = ${col_of(S, c.right, d)}` end
        local kw = j.kind == "left" and "LEFT JOIN" or "INNER JOIN"
        s ..= ` ${kw} ${d.quote(j.collection or j.schema.name)} AS ${d.quote(j.alias)} ON ${string.join(conds, " AND ")}`
    end
    return s
end

local function order_clause(S, plan, d)
    if plan.orders == nil or len(plan.orders) == 0 then return "" end
    local ord = []
    for _, o in plan.orders do
        ord[] = `${col_of(S, o.field, d)} ${string.upper(o.dir or "asc")}`
    end
    return ` ORDER BY ${string.join(ord, ", ")}`
end

local function join_named(S, name)
    for _, j in S.joins or [] do
        if j.alias == name then return j end
    end
    return nil
end

-- The columns a find reads. Without joins: * or the projected root columns.
-- With joins, each column is qualified and named "field" for the query's
-- schema and "alias.field" for a joined one (sql.hydrate splits them back).
local function select_list(S, plan, d)
    local projected = plan.fields ~= nil and len(plan.fields) > 0
    if not S.qualify and not projected then return "*" end
    local seen = [=]
    local cols = []
    local function add(qual, prefix, root)
        local name = prefix .. root
        if seen[name] then return end
        seen[name] = true
        cols[] = S.qualify and `${qual}.${d.quote(root)} AS ${d.quote(name)}` or d.quote(root)
    end
    local function add_all(qual, prefix, sch)
        for _, f in sch.field_order do add(qual, prefix, f) end
    end
    if not projected then
        add_all(S.base, "", S.schema)
        for _, j in S.joins do add_all(d.quote(j.alias), j.alias .. ".", j.schema) end
        return string.join(cols, ", ")
    end
    for _, path in plan.fields do
        local whole = join_named(S, path)
        if whole ~= nil then
            add_all(d.quote(whole.alias), whole.alias .. ".", whole.schema)
        else
            local j, _, rest = query.resolve(S.joins, S.schema, path)
            local root = string.split(rest, ".")[0]
            if j ~= nil then
                add(d.quote(j.alias), j.alias .. ".", root)
            else
                add(S.base, "", root)
            end
        end
    end
    return string.join(cols, ", ")
end

-- ---- Statements ----

-- sql.find(schema, plan, d) → {sql, params} | error
function M.find(schema, plan, d)
    local S = scope(schema, plan, d)
    local p = new_params(d)
    local s = `SELECT ${select_list(S, plan, d)} FROM ${from_clause(S, plan, d)}`
    s ..= where_clause(S, plan, p)?
    local ord = order_clause(S, plan, d)
    s ..= ord
    s = d.paging(s, plan.limit, plan.offset, ord ~= "")
    return {sql = s, params = p.values}
end

-- sql.aggregate(schema, plan, d) → {sql, params} | error
-- For a plan with aggregates: one row per group_by combination, columns named
-- after the group fields and the aggregates; orders may name an aggregate.
function M.aggregate(schema, plan, d)
    local S = scope(schema, plan, d)
    local p = new_params(d)
    local cols = []
    local groups = []
    for _, f in plan.group_by do
        local e = col_of(S, f, d)
        groups[] = e
        cols[] = `${e} AS ${d.quote(f)}`
    end
    local names = [=]
    for _, a in plan.aggregates do
        local arg = a.field == nil and "*" or col_of(S, a.field, d)
        cols[] = `${string.upper(a.fn)}(${arg}) AS ${d.quote(a.name)}`
        names[a.name] = true
    end
    local s = `SELECT ${string.join(cols, ", ")} FROM ${from_clause(S, plan, d)}`
    s ..= where_clause(S, plan, p)?
    if len(groups) > 0 then s ..= ` GROUP BY ${string.join(groups, ", ")}` end
    local ord = []
    for _, o in plan.orders or [] do
        local e = names[o.field] and d.quote(o.field) or col_of(S, o.field, d)
        ord[] = `${e} ${string.upper(o.dir or "asc")}`
    end
    if len(ord) > 0 then s ..= ` ORDER BY ${string.join(ord, ", ")}` end
    s = d.paging(s, plan.limit, plan.offset, len(ord) > 0)
    return {sql = s, params = p.values}
end

-- sql.count(schema, plan, d) → {sql, params} | error (limit/offset respected)
function M.count(schema, plan, d)
    local S = scope(schema, plan, d)
    local p = new_params(d)
    local from = from_clause(S, plan, d)
    local w = where_clause(S, plan, p)?
    if plan.limit == nil and plan.offset == nil then
        return {sql = `SELECT COUNT(*) FROM ${from}${w}`, params = p.values}
    end
    local inner = d.paging(`SELECT 1 AS one FROM ${from}${w}`, plan.limit, plan.offset, false)
    return {sql = `SELECT COUNT(*) FROM (${inner}) AS rdd_sub`, params = p.values}
end

-- sql.insert(schema, doc, d) → {sql, params}
-- With d.returning, the statement ends in RETURNING <primary key>.
function M.insert(schema, doc, d)
    local p = new_params(d)
    local cols = []
    local ph = []
    for _, fname in schema.field_order do
        if doc[fname] ~= nil then
            cols[] = d.quote(fname)
            ph[] = add_param(p, doc[fname], schema.fields[fname])
        end
    end
    local s
    if len(cols) == 0 then
        s = `INSERT INTO ${d.quote(schema.name)} DEFAULT VALUES`
    else
        s = `INSERT INTO ${d.quote(schema.name)} (${string.join(cols, ", ")}) VALUES (${string.join(ph, ", ")})`
    end
    if d.returning and schema.primary_key ~= nil then
        s ..= ` RETURNING ${d.quote(schema.primary_key)}`
    end
    return {sql = s, params = p.values}
end

-- sql.upsert(schema, doc, d) → {sql, params} | error
-- One statement that inserts doc, or updates the row with its primary key.
function M.upsert(schema, doc, d)
    local pk = schema.primary_key
    if pk == nil or doc[pk] == nil then
        return error(`rdd/sql: upsert on '${schema.name}' needs the primary key value`)
    end
    local p = new_params(d)
    local cols = []
    local ph = []
    for _, fname in schema.field_order do
        if doc[fname] ~= nil then
            cols[] = d.quote(fname)
            ph[] = add_param(p, doc[fname], schema.fields[fname])
        end
    end
    return {sql = d.upsert(d.quote(schema.name), cols, ph, d.quote(pk)), params = p.values}
end

-- sql.update(schema, plan, changes, d) → {sql, params} | error
-- A dotted key ("endereco.cidade") changes one value inside a document column.
function M.update(schema, plan, changes, d)
    if plan.joins ~= nil then return error("rdd/sql: update and delete do not take joins") end
    local p = new_params(d)
    local sets = []
    for _, k in list.keys(changes) do
        local v = changes[k]
        local parts = string.split(k, ".")
        local col = d.quote(parts[0])
        if len(parts) == 1 then
            sets[] = `${col} = ${add_param(p, v, field_of(schema, k))}`
        else
            local ph = add_param(p, d.json_value and d.json_value(v) or v, nil)
            sets[] = `${col} = ${d.json_set(col, list.slice(parts, 1), ph, v)}`
        end
    end
    if len(sets) == 0 then return error("rdd/sql: update without changes") end
    local S = scope(schema, plan, d)
    local s = `UPDATE ${S.base} SET ${string.join(sets, ", ")}`
    s ..= where_clause(S, plan, p)?
    return {sql = s, params = p.values}
end

-- sql.delete(schema, plan, d) → {sql, params} | error
function M.delete(schema, plan, d)
    if plan.joins ~= nil then return error("rdd/sql: update and delete do not take joins") end
    local p = new_params(d)
    local S = scope(schema, plan, d)
    local s = `DELETE FROM ${S.base}`
    s ..= where_clause(S, plan, p)?
    return {sql = s, params = p.values}
end

-- sql.create_table(schema, d) → sql
function M.create_table(schema, d)
    local cols = []
    for _, fname in schema.field_order do
        local f = schema.fields[fname]
        local t = d.types[f.type] or d.types.any
        local def
        if f.primary_key and f.auto == true and f.type == "int" then
            def = d.auto_pk(t)
        else
            def = t
            if f.primary_key then def ..= " PRIMARY KEY" end
            if f.unique then def ..= " UNIQUE" end
        end
        cols[] = `${d.quote(fname)} ${def}`
    end
    return d.create_table(d.quote(schema.name), schema.name, string.join(cols, ", "))
end

-- The root columns read for one table (alias nil: the query's own schema):
-- all of them without a projection, or when the projection names the join's
-- alias alone; else the projected roots that belong to that table.
local function hydrate_cols(sch, fields, joins, alias)
    if fields == nil or len(fields) == 0 then return sch.field_order end
    local S = {}
    S.joins = joins
    local cols = []
    local seen = [=]
    for _, path in fields do
        local whole = join_named(S, path)
        if whole ~= nil then
            if whole.alias == alias then return sch.field_order end
        else
            local j, _, rest = query.resolve(joins, nil, path)
            if (j == nil and alias == nil) or (j ~= nil and j.alias == alias) then
                local root = string.split(rest, ".")[0]
                if not seen[root] then
                    seen[root] = true
                    cols[] = root
                end
            end
        end
    end
    return cols
end

-- sql.hydrate(schema, row, fields, d [, plan]) → document
-- Turns a result row back into a document: the schema's fields (or the
-- projected ones), bools and JSON columns decoded by d.read. With the plan's
-- joins, the "alias.field" columns become doc[alias] (left out when a left
-- join found no match).
function M.hydrate(schema, row, fields, d, plan)
    if row == nil then return nil end
    local joins = plan and plan.joins or nil
    local out = {}
    for _, fname in hydrate_cols(schema, fields, joins, nil) do
        out[fname] = d.read(row[fname], schema:field(fname))
    end
    for _, j in joins or [] do
        local sub = {}
        local found = false
        for _, fname in hydrate_cols(j.schema, fields, joins, j.alias) do
            local v = row[j.alias .. "." .. fname]
            if v ~= nil then found = true end
            sub[fname] = d.read(v, j.schema:field(fname))
        end
        if found then out[j.alias] = sub end
    end
    return out
end

-- ---- A ready-made RDD connection ----

local Conn = {}

function Conn.migrate(self, schema)
    local _ = self.db:exec(M.create_table(schema, self.dialect))?
    return true
end

function Conn.insert(self, schema, doc)
    local st = M.insert(schema, doc, self.dialect)
    local pk = schema.primary_key
    local out = {}
    for k, v in doc do out[k] = v end
    if self.dialect.returning and pk ~= nil then
        local id = self.db:value(st.sql, st.params)?
        if out[pk] == nil then out[pk] = id end
        return out
    end
    local _ = self.db:exec(st.sql, st.params)?
    if pk ~= nil and out[pk] == nil and type(self.db.last_insert_id) == "function" then
        out[pk] = self.db:last_insert_id()
    end
    return out
end

function Conn.upsert(self, schema, doc)
    local st = M.upsert(schema, doc, self.dialect)?
    local _ = self.db:exec(st.sql, st.params)?
    local out = {}
    for k, v in doc do out[k] = v end
    return out
end

function Conn.find(self, schema, plan)
    local st = M.find(schema, plan, self.dialect)?
    local rows = self.db:query(st.sql, st.params)?
    local out = []
    for _, r in rows do out[] = M.hydrate(schema, r, plan.fields, self.dialect, plan) end
    return out
end

function Conn.count(self, schema, plan)
    local st = M.count(schema, plan, self.dialect)?
    return self.db:value(st.sql, st.params)
end

function Conn.aggregate(self, schema, plan)
    local d = self.dialect
    local st = M.aggregate(schema, plan, d)?
    local rows = self.db:query(st.sql, st.params)?
    local out = []
    for _, r in rows do
        local row = {}
        for _, f in plan.group_by do row[f] = d.read(r[f], M.field_at(schema, plan, f)) end
        for _, a in plan.aggregates do
            local v = r[a.name]
            -- min/max of a bool or JSON field come back in the column's encoding
            if (a.fn == "min" or a.fn == "max") and a.field ~= nil then v = d.read(v, M.field_at(schema, plan, a.field)) end
            row[a.name] = v
        end
        out[] = row
    end
    return out
end

function Conn.update(self, schema, plan, changes)
    local st = M.update(schema, plan, changes, self.dialect)?
    return self.db:exec(st.sql, st.params)
end

function Conn.delete(self, schema, plan)
    local st = M.delete(schema, plan, self.dialect)?
    return self.db:exec(st.sql, st.params)
end

function Conn.transaction(self, fn)
    if type(self.db.transaction) ~= "function" then return fn(self) end
    return self.db:transaction(function(_) return fn(self) end)
end

function Conn.close(self)
    return self.db:close()
end

-- sql.connection(db, d) → RDD connection over a database handle
-- db needs query(sql, params) → rows, exec(sql, params) → changed count,
-- value(sql, params) → first column of the first row and close(); it may
-- have last_insert_id() and transaction(fn). The sqlite library's handle
-- fits as is:
--
--   rdd.register_driver("sqlite", {open = function(opts)
--       local db = sqlite.open(opts.path or ":memory:")?
--       return sql.connection(db, sql.dialects.sqlite)
--   end})
function M.connection(db, d)
    local c = {}
    c.db = db
    c.dialect = d or M.dialects.sqlite
    c.joins = true -- find/count/aggregate compile plan.joins
    for k, f in Conn do c[k] = f end
    return c
end

return M
